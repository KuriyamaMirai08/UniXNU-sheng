+/* 24A446 routes the dictionary RPC through an explicitly supplied handler.
+ * Its old four-void-pointer virtual method only retrieves that handler. */
+extern const OSSymbol * gIOUserPlatformFunctionHandlerGet;
+
+kern_return_t
+IOService::CallPlatformFunction_Impl(
+	OSString * functionName,
+	bool waitForFunction,
+	OSDictionary * inParam,
+	OSDictionary ** outParam)
+{
+	if (functionName == NULL) {
+		return kIOReturnBadArgument;
+	}
+
+	IOUserServer * us = (IOUserServer *)thread_iokit_tls_get(0);
+	if (us == NULL || !us->isPlatformDriver()) {
+		return kIOReturnUnsupported;
+	}
+	if (reserved && reserved->uvars && reserved->uvars->userServer != us) {
+		return CallPlatformFunction(functionName, waitForFunction, inParam, outParam);
+	}
+
+	CallPlatformFunction_Handler handler = NULL;
+	IOReturn ret = callPlatformFunction(gIOUserPlatformFunctionHandlerGet,
+	    true, &handler, NULL, NULL, NULL);
+	if (ret != kIOReturnSuccess || handler == NULL) {
+		return kIOReturnUnsupported;
+	}
+
+	/* Never call the incompatible legacy method with dictionary arguments.
+	 * Resolve the actual virtual member using native C++/PAC semantics. */
+	typedef IOReturn (IOService::*LegacyPlatformMethod)(const OSSymbol *, bool,
+	    void *, void *, void *, void *);
+	CallPlatformFunction_Handler legacy = OSMemberFunctionCast(
+	    CallPlatformFunction_Handler, this,
+	    static_cast<LegacyPlatformMethod>(&IOService::callPlatformFunction));
+	if (handler == legacy) {
+		IOLog("callPlatformFunction disallowed for user platform function: service %s, 0x%llx\n",
+		    getName(), getRegistryEntryID());
+		return kIOReturnUnsupported;
+	}
+
+	const OSSymbol * symbol = OSSymbol::withString(functionName);
+	/* The retained implementation passes NULL to the typed handler on an
+	 * allocation failure; preserve that contract and the handler's result. */
+	ret = handler(this, const_cast<OSSymbol *>(symbol), waitForFunction,
+	    inParam, outParam);
+	if (symbol) {
+		symbol->release();
+	}
+	return ret;
+}
