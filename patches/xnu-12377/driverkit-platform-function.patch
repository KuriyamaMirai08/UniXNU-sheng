diff --git a/libkern/c++/OSUnserializeXML.cpp b/libkern/c++/OSUnserializeXML.cpp
index 65084ad..4ca531a 100644
--- a/libkern/c++/OSUnserializeXML.cpp
+++ b/libkern/c++/OSUnserializeXML.cpp
@@ -1 +1,109 @@
 #include <libkern/c++/OSUnserializeXMLSharedImplementation.h>
+
+#ifdef XNU_KERNEL_PRIVATE
+#include <libkern/c++/OSCollectionIterator.h>
+
+/* XML parsing constructs private containers before this value walk. The
+ * grammar and its checked-in generated implementation remain identical.
+ * Track visited containers to bound depth and preserve shared references. */
+static bool
+OSUnserializeEditXML(OSObject * object, OSUnserializeCallback callback,
+    void * reference, unsigned int options, OSArray * visited, unsigned int depth)
+{
+	OSCollection * collection = OSDynamicCast(OSCollection, object);
+	if (!collection) {
+		return true;
+	}
+	if (visited->getNextIndexOfObject(collection, 0) != -1U) {
+		return true;
+	}
+	if (depth >= 64 || !visited->setObject(collection)) {
+		return false;
+	}
+	OSDictionary * dict = OSDynamicCast(OSDictionary, collection);
+	OSArray * array = OSDynamicCast(OSArray, collection);
+	OSSet * set = OSDynamicCast(OSSet, collection);
+	OSArray * entries = OSArray::withCapacity(collection->getCount());
+	OSCollectionIterator * iterator = OSCollectionIterator::withCollection(collection);
+	if (!entries || !iterator) {
+		OSSafeReleaseNULL(entries);
+		OSSafeReleaseNULL(iterator);
+		return false;
+	}
+	OSObject * entry;
+	bool ok = true;
+	while ((entry = iterator->getNextObject())) {
+		if (!entries->setObject(entry)) {
+			ok = false;
+			break;
+		}
+	}
+	if (!iterator->isValid()) {
+		ok = false;
+	}
+	iterator->release();
+	for (unsigned int index = 0; ok && index < entries->getCount(); ++index) {
+		const OSSymbol * key = dict ? OSDynamicCast(OSSymbol, entries->getObject(index)) : NULL;
+		OSObject * value = dict ? dict->getObject(key) : entries->getObject(index);
+		if (!value || (dict && !key) || !OSUnserializeEditXML(value, callback, reference,
+		    options, visited, depth + 1)) {
+			ok = false;
+			break;
+		}
+		unsigned int option = dict ? kOSSerializeEditDictionary :
+		    (array ? kOSSerializeEditArray : kOSSerializeEditSet);
+		if (!(options & option)) {
+			continue;
+		}
+		OSObject * edited = (*callback)(reference, collection, key, value);
+		if (!edited) {
+			ok = false;
+			break;
+		}
+		if (dict) {
+			ok = dict->setObject(key, edited);
+		} else if (array) {
+			array->replaceObject(index, edited);
+		} else if (set) {
+			if (edited != value) {
+				set->removeObject(value);
+				ok = set->containsObject(edited) || set->setObject(edited);
+			}
+		} else {
+			ok = false;
+		}
+		edited->release();
+	}
+	entries->release();
+	return ok;
+}
+
+OSObject *
+OSUnserializeXML(const char * buffer, size_t bufferSize,
+    OSUnserializeCallback callback, void * reference, unsigned int options,
+    OSString ** errorString)
+{
+	if (!callback || !(options & kOSSerializeEditAll)) {
+		return OSUnserializeXML(buffer, bufferSize, errorString);
+	}
+	if (!buffer || bufferSize < sizeof(kOSSerializeBinarySignature)) {
+		return NULL;
+	}
+	if (!memcmp(buffer, kOSSerializeBinarySignature, sizeof(kOSSerializeBinarySignature)) ||
+	    (kOSSerializeIndexedBinarySignature == (uint8_t) buffer[0])) {
+		return OSUnserializeBinary(buffer, bufferSize, callback, reference, options, errorString);
+	}
+	OSObject * object = OSUnserializeXML(buffer, bufferSize, errorString);
+	if (!object) {
+		return NULL;
+	}
+	OSArray * visited = OSArray::withCapacity(8);
+	bool ok = visited && OSUnserializeEditXML(object, callback, reference, options, visited, 0);
+	OSSafeReleaseNULL(visited);
+	if (!ok) {
+		object->release();
+		return NULL;
+	}
+	return object;
+}
+#endif /* XNU_KERNEL_PRIVATE */
