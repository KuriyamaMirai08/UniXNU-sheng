diff --git a/iokit/DriverKit/restore_platform_rpc.py b/iokit/DriverKit/restore_platform_rpc.py
new file mode 100644
index 0000000..934e786
--- /dev/null
+++ b/iokit/DriverKit/restore_platform_rpc.py
@@ -0,0 +1,56 @@
+#!/usr/bin/env python3
+"""Restore the two observed 24A446 generator contracts for one private RPC.
+
+DriverKit-440 keeps its actual message structs and runtime checks. Its generator
+does not encode SERIALIZABLE into bit8 and leaves a rejected output retained.
+Restrict this compatibility step to the exact generated wrapper; fail on drift.
+"""
+import argparse
+import hashlib
+from pathlib import Path
+
+OLD_FLAGS = """    msg->content.__hdr.flags = 0*kIORPCMessageOneway
+                             | 0*kIORPCMessageSimpleReply
+                             | 0*kIORPCMessageLocalHost
+                             | 0*kIORPCMessageOnqueue;"""
+OLD_OUTPUT = """        *outParam = OSDynamicCast(OSDictionary, (OSObject *) rpl->content.outParam);
+        if (rpl->content.outParam && !*outParam) ret = kIOReturnBadArgument;"""
+NEW_OUTPUT = """        *outParam = OSDynamicCast(OSDictionary, (OSObject *) rpl->content.outParam);
+        if (rpl->content.outParam && !*outParam)
+        {
+            ((OSObject *) rpl->content.outParam)->release();
+            ret = kIOReturnBadArgument;
+        }"""
+
+
+def restore(text):
+    marker = "\nIOService::CallPlatformFunction(\n"
+    if text.count(marker) != 1:
+        raise ValueError("Platform RPC wrapper identity changed")
+    start = text.index(marker)
+    end = text.index("\n}\n", start) + 3
+    wrapper = text[start:end]
+    new_flags = OLD_FLAGS + "\n    msg->content.__hdr.flags |= kIORPCMessageSerializable;"
+    if new_flags in wrapper and NEW_OUTPUT in wrapper:
+        return text
+    if wrapper.count(OLD_FLAGS) != 1 or wrapper.count(OLD_OUTPUT) != 1:
+        raise ValueError("Platform RPC generation contract changed")
+    if "IOService_CallPlatformFunction_ID" not in wrapper or "msgh_descriptor_count = 3" not in wrapper:
+        raise ValueError("Platform RPC message shape changed")
+    wrapper = wrapper.replace(OLD_FLAGS, new_flags, 1).replace(OLD_OUTPUT, NEW_OUTPUT, 1)
+    return text[:start] + wrapper + text[end:]
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("implementation", type=Path)
+    args = parser.parse_args()
+    raw = args.implementation.read_bytes()
+    updated = restore(raw.decode("utf-8")).encode("utf-8")
+    if raw != updated:
+        args.implementation.write_bytes(updated)
+    print("platform RPC codegen: " + hashlib.sha256(raw).hexdigest() + " -> " + hashlib.sha256(updated).hexdigest())
+
+
+if __name__ == "__main__":
+    main()
