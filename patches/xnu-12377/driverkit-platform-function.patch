+struct IORPCObjectEditContext {
+	task_t task;
+	IOReturn status;
+	OSArray * rights;
+};
+
+static void
+IORPCReleaseObjectRights(task_t task, OSArray * rights)
+{
+	if (!rights) {
+		return;
+	}
+	for (unsigned int index = 0; index < rights->getCount(); ++index) {
+		OSNumber * number = OSDynamicCast(OSNumber, rights->getObject(index));
+		if (number && task) {
+			(void) iokit_mod_send_right(task, number->unsigned32BitValue(), -1);
+		}
+	}
+	rights->release();
+}
+
+static const OSMetaClassBase *
+IORPCSerializeObject(void * reference, OSSerialize * serializer __unused,
+    OSCollection * container __unused, const OSSymbol * name __unused,
+    const OSMetaClassBase * value)
+{
+	IORPCObjectEditContext * context = (IORPCObjectEditContext *) reference;
+	if (context->status != kIOReturnSuccess || !value ||
+	    OSDynamicCast(OSString, value) || OSDynamicCast(OSNumber, value) ||
+	    OSDynamicCast(OSData, value) || OSDynamicCast(OSBoolean, value) ||
+	    OSDynamicCast(OSCollection, value)) {
+		if (value) {
+			value->retain();
+		}
+		return value;
+	}
+	OSObject * object = const_cast<OSObject *>(OSDynamicCast(OSObject, value));
+	if (!object) {
+		value->retain();
+		return value;
+	}
+	if (!context->task) {
+		context->status = kIOReturnBadArgument;
+		value->retain();
+		return value;
+	}
+	mach_port_name_t port = iokit_make_send_right(context->task, object, IKOT_UEXT_OBJECT);
+	if (!MACH_PORT_VALID(port)) {
+		context->status = kIOReturnBadArgument;
+		value->retain();
+		return value;
+	}
+	if (!context->rights) {
+		context->rights = OSArray::withCapacity(1);
+	}
+	OSNumber * number = OSNumber::withNumber(port, 62);
+	if (!context->rights || !number || !context->rights->setObject(number)) {
+		(void) iokit_mod_send_right(context->task, port, -1);
+		OSSafeReleaseNULL(number);
+		context->status = kIOReturnNoMemory;
+		value->retain();
+		return value;
+	}
+	return number;
+}
+
+static OSObject *
+IORPCUnserializeObject(void * reference, OSCollection * container __unused,
+    const OSSymbol * name __unused, OSObject * value)
+{
+	IORPCObjectEditContext * context = (IORPCObjectEditContext *) reference;
+	OSNumber * number = OSDynamicCast(OSNumber, value);
+	if (context->status == kIOReturnSuccess && number && number->numberOfBits() == 62) {
+		OSObject * object = context->task ? iokit_lookup_object_with_port_name(
+		    number->unsigned32BitValue(), IKOT_UEXT_OBJECT, context->task) : NULL;
+		if (object) {
+			return object;
+		}
+		context->status = kIOReturnBadArgument;
+	}
+	if (value) {
+		value->retain();
+	}
+	return value;
+}
