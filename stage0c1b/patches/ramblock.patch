+#pragma once
+// Version 2 overlay with a checkpoint base, two published snapshot banks, two
+// roots, and a bounded WAL. Version 1 SHNGDATA remains an independent legacy
+// format and is never migrated implicitly.
+#include <stdint.h>
+#include <stddef.h>
+#include <string.h>
