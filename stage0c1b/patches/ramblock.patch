+// SPDX-License-Identifier: BSD-2-Clause-Patent
+#pragma once
+
+// Serializes the lifetime of a persistent Data store. The state is deny-by-default:
+// writes are allowed while a verified attachment is still in progress, or only after
+// the caller publishes a write-through/write-back role. Any authority epoch change or
+// store error permanently fails this attachment. A harmless failure before the store
+// was touched can abort back to Detached for one complete retry.
+
+#include <stdint.h>
+
+namespace persist {
+
+enum class StoreRole : uint32_t {
+  Detached = 0,
+  Attaching = 1,
+  ReadOnly = 2,
+  WriteThrough = 3,
+  WriteBack = 4,
+  Failed = 5
+};
+
+enum class StoreFault : uint32_t {
+  None = 0,
+  AttachRejected = 1,
+  AuthorityChanged = 2,
+  AuthorityRejected = 3,
+  StoreWrite = 4,
+  StoreSync = 5,
+  OverlayReset = 6,
+  OverlayFlush = 7,
+  InvalidState = 8
+};
+
+class StoreState {
+  uint32_t stateValue = static_cast<uint32_t>(StoreRole::Detached);
+  uint32_t expectedEpoch = 0;
+  uint32_t faultValue = static_cast<uint32_t>(StoreFault::None);
+  uint32_t attachGeneration = 0;
+  uint64_t failureCount = 0;
+
+public:
+  StoreRole role() const
+  {
+    return static_cast<StoreRole>(__atomic_load_n(&stateValue, __ATOMIC_ACQUIRE));
+  }
+
+  StoreFault fault() const
+  {
+    return static_cast<StoreFault>(__atomic_load_n(&faultValue, __ATOMIC_ACQUIRE));
+  }
+
+  uint32_t expected() const { return __atomic_load_n(&expectedEpoch, __ATOMIC_ACQUIRE); }
+  uint32_t generation() const { return __atomic_load_n(&attachGeneration, __ATOMIC_ACQUIRE); }
+  uint64_t failures() const { return __atomic_load_n(&failureCount, __ATOMIC_ACQUIRE); }
+
+  bool isFailed() const { return role() == StoreRole::Failed; }
+  bool isAttaching() const { return role() == StoreRole::Attaching; }
+  bool isReadOnly() const { return role() == StoreRole::ReadOnly; }
+  bool isWritable() const
+  {
+    const StoreRole value = role();
+    return value == StoreRole::WriteThrough || value == StoreRole::WriteBack;
+  }
+  bool isAttached() const
+  {
+    const StoreRole value = role();
+    return value == StoreRole::ReadOnly || value == StoreRole::WriteThrough || value == StoreRole::WriteBack;
+  }
+  bool canBeginAttach() const { return role() == StoreRole::Detached; }
+
+  bool beginAttach(uint32_t authorityEpoch)
+  {
+    if (!authorityEpoch) return false;
+    uint32_t expected = static_cast<uint32_t>(StoreRole::Detached);
+    if (!__atomic_compare_exchange_n(&stateValue, &expected, static_cast<uint32_t>(StoreRole::Attaching),
+                                     false, __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE)) return false;
+    __atomic_store_n(&expectedEpoch, authorityEpoch, __ATOMIC_RELEASE);
+    __atomic_store_n(&faultValue, static_cast<uint32_t>(StoreFault::None), __ATOMIC_RELEASE);
+    __atomic_add_fetch(&attachGeneration, 1, __ATOMIC_ACQ_REL);
+    return true;
+  }
+
+  // Only valid before open() has performed any store I/O.
+  bool abortAttach()
+  {
+    uint32_t expected = static_cast<uint32_t>(StoreRole::Attaching);
+    return __atomic_compare_exchange_n(&stateValue, &expected, static_cast<uint32_t>(StoreRole::Detached),
+                                       false, __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE);
+  }
+
+  bool commitReadOnly()
+  {
+    uint32_t expected = static_cast<uint32_t>(StoreRole::Attaching);
+    return __atomic_compare_exchange_n(&stateValue, &expected, static_cast<uint32_t>(StoreRole::ReadOnly),
+                                       false, __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE);
+  }
+
+  bool commitWritable(bool writeBack)
+  {
+    const StoreRole target = writeBack ? StoreRole::WriteBack : StoreRole::WriteThrough;
+    uint32_t expected = static_cast<uint32_t>(StoreRole::Attaching);
+    return __atomic_compare_exchange_n(&stateValue, &expected, static_cast<uint32_t>(target),
+                                       false, __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE);
+  }
+
+  // The attachment may perform its reset writes before writable state is published,
+  // but every such operation is still bound to the epoch verified at beginAttach().
+  bool authorizes(uint32_t currentEpoch) const
+  {
+    const StoreRole value = role();
+    return currentEpoch && expected() == currentEpoch &&
+           (value == StoreRole::Attaching || value == StoreRole::WriteThrough || value == StoreRole::WriteBack);
+  }
+
+  bool authorityStable(uint32_t currentEpoch) const
+  {
+    const StoreRole value = role();
+    return currentEpoch && expected() == currentEpoch &&
+           (value == StoreRole::Attaching || value == StoreRole::ReadOnly ||
+            value == StoreRole::WriteThrough || value == StoreRole::WriteBack);
+  }
+
+  bool fail(StoreFault reason)
+  {
+    for (;;) {
+      uint32_t current = __atomic_load_n(&stateValue, __ATOMIC_ACQUIRE);
+      if (current == static_cast<uint32_t>(StoreRole::Failed)) return false;
+      if (__atomic_compare_exchange_n(&stateValue, &current, static_cast<uint32_t>(StoreRole::Failed),
+                                      false, __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE)) {
+        __atomic_store_n(&faultValue, static_cast<uint32_t>(reason), __ATOMIC_RELEASE);
+        __atomic_add_fetch(&failureCount, 1, __ATOMIC_ACQ_REL);
+        return true;
+      }
+    }
+  }
+};
+
+}  // namespace persist
