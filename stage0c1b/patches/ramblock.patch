+
+inline bool decodeRoot(const uint8_t block[kBlock], uint64_t pages,
+                       const uint8_t seed[32], Root *root)
+{
+  if (!root || memcmp(block, "SHNGV2RT", 8) ||
+      get32(block + 8) != kVersion ||
+      get64(block + 96) != kPagesPerTransaction ||
+      get64(block + 104) != kTransactionBlocks ||
+      get64(block + 112) != crc64(block, 112)) {
+    return false;
+  }
