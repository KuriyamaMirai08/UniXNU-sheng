+  {
+    if (!entries || !entryCapacity) return false;
+    uint32_t at = uint32_t(entryHash(page, entryCapacity));
+    for (uint32_t probes = 0; probes < entryCapacity; ++probes) {
+      Entry *entry = &entries[at];
+      if (!atomicLoadByte(&entry->active, kAtomicAcquire)) {
+        if (found) *found = nullptr;
+        if (insertAt) *insertAt = at;
+        return true;
+      }
+      if (entry->page == page) {
+        if (found) *found = entry;
+        if (insertAt) *insertAt = at;
+        return true;
+      }
