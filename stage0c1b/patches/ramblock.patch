+  bool has(uint64_t index) const
+  {
+    return rawHas(index);
+  }
+
+  uint64_t snapshotStart(uint32_t bank) const
+  {
+    return bank == kSnapshotBankA ? layout.snapshotStartA : layout.snapshotStartB;
+  }
+
+  uint64_t checksumStart(uint32_t bank) const
+  {
+    uint64_t bitmapCount = 0;
+    uint64_t start = snapshotStart(bank);
+    if (!bitmapBlocksFor(pages, &bitmapCount) ||
+        !checkedAdd(start, kSnapshotHeaderBlocks, &start) ||
+        !checkedAdd(start, bitmapCount, &start)) {
+      return UINT64_MAX;
+    }
+    return start;
+  }
+
+  template <class Ops>
+  bool readPageUnlocked(Ops &ops, uint64_t index, void *dst) const
+  {
+    if (!active || index >= pages || !dst) return false;
+    uint8_t block[kBlock];
+    Entry *entry = nullptr;
+    if (!entryFind(index, &entry, nullptr)) return false;
+    if (entry) {
+      if (!ops.read(entry->dataBlock, 1, block) ||
+          crc32(block, sizeof block) != entry->checksum) {
+        return false;
+      }
+    } else {
+      if (!checkpointCapable || !rawHas(index)) return false;
+      const uint64_t checksumBase = checksumStart(checkpointBank);
+      if (checksumBase == UINT64_MAX) return false;
+      const uint64_t byteOffset = index * 4;
+      uint64_t checksumBlock = 0;
+      if (!checkedAdd(checksumBase, byteOffset / kBlock, &checksumBlock) ||
+          !ops.read(checksumBlock, 1, block)) {
+        return false;
+      }
+      const uint32_t expected =
+          get32(block + (byteOffset % kBlock));
+      if (!ops.read(layout.baseStart + index, 1, block) ||
+          crc32(block, sizeof block) != expected) {
+        return false;
+      }
+    }
+    memcpy(dst, block, sizeof block);
+    return true;
+  }
+
+  template <class Ops>
+  bool readPage(Ops &ops, uint64_t index, void *dst) const
+  {
+    lockWordWait(&operationLock);
+    const bool ok = readPageUnlocked(ops, index, dst);
+    unlockWord(&operationLock);
+    return ok;
+  }
+
+  bool encodeSnapshotHeader(uint8_t header[kBlock], uint32_t bank,
+                            uint64_t snapshotSequence,
+                            uint64_t generation, uint64_t presentCount,
+                            uint64_t bitmapCrc, uint64_t checksumCrc)
+  {
+    uint64_t bitmapCount = 0, checksums = 0;
+    if (!bitmapBlocksFor(pages, &bitmapCount) ||
+        !checksumBlocksFor(pages, &checksums)) return false;
+    memset(header, 0, kBlock);
+    memcpy(header, "SHNGV2SN", 8);
+    put32(header + 8, kVersion);
+    put32(header + 12, 64);
+    put32(header + 16, bank);
+    put32(header + 20, 0);
+    memcpy(header + 24, seedCopy, 32);
+    put64(header + 56, pages);
+    put64(header + 64, snapshotSequence);
+    put64(header + 72, bitmapCount);
+    put64(header + 80, checksums);
+    put64(header + 88, presentCount);
+    put64(header + 96, bitmapCrc);
+    put64(header + 104, checksumCrc);
+    put64(header + 112, generation);
+    put64(header + 120, crc64(header, 120));
+    return true;
+  }
+
+  bool decodeSnapshotHeader(const uint8_t header[kBlock], uint32_t bank,
+                            uint64_t snapshotSequence,
+                            uint64_t generation, uint64_t *presentCount,
+                            uint64_t *bitmapCrc, uint64_t *checksumCrc)
+  {
+    uint64_t bitmapCount = 0, checksums = 0;
+    if (!presentCount || !bitmapCrc || !checksumCrc ||
+        !bitmapBlocksFor(pages, &bitmapCount) ||
+        !checksumBlocksFor(pages, &checksums) ||
+        memcmp(header, "SHNGV2SN", 8) ||
+        get32(header + 8) != kVersion ||
+        get32(header + 12) != 64 ||
+        get32(header + 16) != bank ||
+        get32(header + 20) != 0 ||
+        memcmp(header + 24, seedCopy, 32) ||
+        get64(header + 56) != pages ||
+        get64(header + 64) != snapshotSequence ||
+        get64(header + 72) != bitmapCount ||
+        get64(header + 80) != checksums ||
+        get64(header + 112) != generation ||
+        get64(header + 120) != crc64(header, 120) ||
+        !allZero(header + 128, kBlock - 128)) {
+      return false;
+    }
+    *presentCount = get64(header + 88);
+    *bitmapCrc = get64(header + 96);
+    *checksumCrc = get64(header + 104);
+    return *presentCount <= pages;
+  }
+
+  template <class Ops>
+  bool writeSnapshotUnlocked(Ops &ops, uint32_t bank, uint64_t sequence,
+                             uint64_t generation)
+  {
+    uint64_t bitmapCount = 0, checksumCount = 0;
+    if (!checkpointCapable || !bitmapBlocksFor(pages, &bitmapCount) ||
+        !checksumBlocksFor(pages, &checksumCount)) return false;
+    const uint64_t start = snapshotStart(bank);
+    const uint64_t bitmapStart = start + kSnapshotHeaderBlocks;
+    const uint64_t checksumBase = bitmapStart + bitmapCount;
+
+    uint64_t bitmapDigest = crc64Init();
+    for (uint64_t b = 0; b < bitmapCount; ++b) {
+      bitmapDigest = crc64Update(bitmapDigest, bitmap + b * kBlock, kBlock);
+      if (!ops.write(bitmapStart + b, 1, bitmap + b * kBlock)) return false;
+    }
+    const uint64_t bitmapCrc = crc64Finish(bitmapDigest);
+
+    uint64_t checksumDigest = crc64Init();
+    uint8_t image[kBlock], pageImage[kBlock];
+    for (uint64_t b = 0; b < checksumCount; ++b) {
+      memset(image, 0, sizeof image);
+      const uint64_t first = b * (kBlock / 4ULL);
+      const uint64_t end = first + kBlock / 4ULL < pages
+                               ? first + kBlock / 4ULL : pages;
+      for (uint64_t pageIndex = first; pageIndex < end; ++pageIndex) {
+        if (!rawHas(pageIndex)) continue;
+        if (!readPageUnlocked(ops, pageIndex, pageImage)) {
+          return false;
+        }
+        const uint32_t checksum = crc32(pageImage, kBlock);
+        put32(image + (pageIndex - first) * 4, checksum);
+      }
+      checksumDigest = crc64Update(checksumDigest, image, kBlock);
+      if (!ops.write(checksumBase + b, 1, image)) return false;
+    }
+    const uint64_t checksumCrc = crc64Finish(checksumDigest);
+
+    uint8_t header[kBlock];
+    if (!encodeSnapshotHeader(header, bank, sequence, generation, present,
+                              bitmapCrc, checksumCrc) ||
+        !ops.write(start, 1, header) ||
+        !ops.sync()) {
+      return false;
+    }
+    return true;
+  }
+
+  template <class Ops>
+  bool loadSnapshotUnlocked(Ops &ops, uint32_t bank, uint64_t sequence,
+                            uint64_t generation)
+  {
+    uint64_t bitmapCount = 0, checksumCount = 0, headerPresent = 0;
+    uint64_t bitmapExpected = 0, checksumExpected = 0;
+    if (!checkpointCapable || !bitmapBlocksFor(pages, &bitmapCount) ||
+        !checksumBlocksFor(pages, &checksumCount)) return false;
+    const uint64_t start = snapshotStart(bank);
+    const uint64_t bitmapStart = start + kSnapshotHeaderBlocks;
+    const uint64_t checksumBase = bitmapStart + bitmapCount;
+    uint8_t block[kBlock];
+    if (!ops.read(start, 1, block) ||
+        !decodeSnapshotHeader(block, bank, sequence, generation,
+                              &headerPresent, &bitmapExpected,
+                              &checksumExpected)) {
+      return false;
+    }
+
+    uint64_t bitmapDigest = crc64Init();
+    uint64_t presentCount = 0;
+    for (uint64_t b = 0; b < bitmapCount; ++b) {
+      if (!ops.read(bitmapStart + b, 1, bitmap + b * kBlock)) return false;
+      bitmapDigest = crc64Update(bitmapDigest, bitmap + b * kBlock, kBlock);
+    }
+    if (crc64Finish(bitmapDigest) != bitmapExpected) return false;
+    for (uint64_t pageIndex = 0; pageIndex < pages; ++pageIndex)
+      if (rawHas(pageIndex)) ++presentCount;
+    if (presentCount != headerPresent) return false;
+    for (uint64_t i = pages; i < bitmapCount * kBlock * 8ULL; ++i)
+      if (rawHas(i)) return false;
+
+    uint64_t checksumDigest = crc64Init();
+    for (uint64_t b = 0; b < checksumCount; ++b) {
+      if (!ops.read(checksumBase + b, 1, block)) return false;
+      checksumDigest = crc64Update(checksumDigest, block, kBlock);
+    }
+    if (crc64Finish(checksumDigest) != checksumExpected) return false;
+    present = presentCount;
+    return true;
+  }
+
+  template <class Ops>
+  bool verifyEffectiveUnlocked(Ops &ops)
+  {
+    uint8_t page[kBlock];
+    for (uint64_t index = 0; index < pages; ++index) {
+      if (!rawHas(index)) continue;
+      if (!readPageUnlocked(ops, index, page)) return false;
+    }
+    return true;
+  }
+
+  template <class Ops>
+  bool clearWalUnlocked(Ops &ops)
+  {
+    uint8_t zero[kBlock] = {};
+    // A one-block source cannot be mistaken for a larger contiguous transfer.
+    // The UFS StoreOps layer may coalesce safe runs above this interface.
+    for (uint64_t blockIndex = 0; blockIndex < walBlocks; ++blockIndex)
+      if (!ops.write(walStart + blockIndex, 1, zero)) return false;
+    return ops.sync();
+  }
+
+  template <class Ops>
+  bool checkpointUnlocked(Ops &ops)
+  {
+    if (!active || readOnly || inconsistent || checkpointFailed ||
+        !checkpointCapable || checkpointGeneration == UINT64_MAX ||
+        lastSequence < baseSequence) {
+      return false;
+    }
+    if (lastSequence == baseSequence) return ops.sync();
+
+    uint8_t page[kBlock];
+    for (uint64_t i = 0; i < pages; ++i) {
+      if (!rawHas(i)) continue;
+      if (!readPageUnlocked(ops, i, page) ||
+          !ops.write(layout.baseStart + i, 1, page)) {
+        checkpointFailed = true;
+        fail();
+        return false;
+      }
+    }
+    if (!ops.sync()) {
+      checkpointFailed = true;
+      fail();
+      return false;
+    }
+
+    const uint32_t newBank = checkpointBank == kSnapshotBankA
+                                 ? kSnapshotBankB : kSnapshotBankA;
+    const uint64_t newGeneration = checkpointGeneration + 1;
+    if (!writeSnapshotUnlocked(ops, newBank, lastSequence, newGeneration)) {
+      checkpointFailed = true;
+      fail();
+      return false;
+    }
+
+    uint8_t rootA[kBlock], rootB[kBlock];
+    encodeRoot(rootA, pages, seedCopy, lastSequence, newGeneration,
+               walStart, walBlocks, newBank, layout.snapshotBlocks,
+               layout.baseStart, layout.baseBlocks, 0);
+    encodeRoot(rootB, pages, seedCopy, lastSequence, newGeneration,
+               walStart, walBlocks, newBank, layout.snapshotBlocks,
+               layout.baseStart, layout.baseBlocks, 0);
+    if (!ops.write(kRootSlotB, 1, rootB) || !ops.sync() ||
+        !ops.write(kRootSlotA, 1, rootA) || !ops.sync()) {
+      checkpointFailed = true;
+      fail();
+      return false;
+    }
+
+    checkpointBank = newBank;
+    checkpointGeneration = newGeneration;
+    baseSequence = lastSequence;
+    walHeadSlot = 0;
+    walHeadSequence = baseSequence + 1;
+    spaceExhausted = false;
+    if (!clearWalUnlocked(ops) || !indexRebuild()) {
+      checkpointFailed = true;
+      fail();
+      return false;
+    }
+    nextSlot = 0;
+    nextSequence = baseSequence + 1;
+    recoveredCommittedTail = false;
+    stoppedAtUncommittedTail = false;
+    return true;
+  }
+
+  template <class Ops>
+  bool checkpoint(Ops &ops)
+  {
+    if (!active || readOnly || inconsistent || !checkpointCapable) return false;
+    lockWordWait(&operationLock);
+    const bool ok = checkpointUnlocked(ops);
+    unlockWord(&operationLock);
+    return ok;
+  }
+
+  template <class Ops>
+  bool appendTransactionUnlocked(Ops &ops, uint64_t index, uint32_t count,
+                                 const void *data, uint32_t kind)
+  {
+    if (!readOnly && active && !inconsistent && nextSlot >= slotCount) {
+      spaceExhausted = true;
+      if (!checkpointUnlocked(ops)) {
+        lastFault = 1;
+        fail();
+        return false;
+      }
+    }
+    if (readOnly || !active || inconsistent ||
+        lastSequence >= UINT64_MAX - 1 ||
+        (kind == kTransactionKindNormal &&
+         (!count || count > kPagesPerTransaction || index >= pages ||
+          count > pages - index || !data ||
+          !entryCanAccept(index, count))) ||
+        (kind == kTransactionKindReset && count != 0)) {
+      lastFault = 2;
+      return false;
+    }
+    if (nextSlot >= slotCount) {
+      spaceExhausted = true;
+      lastFault = 3;
+      return false;
+    }
+
+    uint64_t slotOffset = 0, slotStart = 0;
+    if (!checkedMul(nextSlot, kTransactionBlocks, &slotOffset) ||
+        !checkedAdd(walStart, slotOffset, &slotStart)) {
+      fail();
+      lastFault = 4;
+      return false;
+    }
+
+    uint8_t begin[kBlock], commit[kBlock];
+    memset(begin, 0, sizeof begin);
+    memset(commit, 0, sizeof commit);
+    memcpy(begin, "SHNGV2JB", 8);
+    put32(begin + 8, kVersion);
+    put32(begin + 12, kBeginBytes);
+    put64(begin + 16, nextSequence);
+    put64(begin + 24, lastSequence);
+    memcpy(begin + 32, seedCopy, 32);
+    put64(begin + 64, pages);
+    put32(begin + 72, count);
+    put32(begin + 76, kind);
+    put32(begin + 80, uint32_t(nextSlot));
+
+    const uint8_t *bytes = static_cast<const uint8_t *>(data);
+    if (kind == kTransactionKindNormal) {
+      for (uint32_t i = 0; i < count; ++i) {
+        uint8_t *descriptor = begin + 128 + i * 24;
+        put64(descriptor, index + i);
+        put32(descriptor + 8, i + 1);
+        put32(descriptor + 12, crc32(bytes + size_t(i) * kBlock, kBlock));
+      }
+    }
+    put64(begin + 320, crc64(begin, 320));
+
+    if (!ops.write(slotStart, 1, begin) ||
+        (count && !ops.write(slotStart + 1, count, data)) ||
+        !ops.sync()) {
+      fail();
+      lastFault = 5;
+      return false;
+    }
+
+    const uint64_t beginCrc = get64(begin + 320);
+    uint64_t digestState = crc64Update(crc64Init(), begin, sizeof begin);
+    for (uint32_t i = 0; i < count; ++i)
+      digestState = crc64Update(digestState, bytes + size_t(i) * kBlock, kBlock);
+    const uint64_t digest = crc64Finish(digestState);
+    for (uint32_t copy = 0; copy < 2; ++copy) {
+      uint8_t *record = commit + copy * kCommitCopyOffset;
+      memcpy(record, "SHNGV2JC", 8);
+      put32(record + 8, kVersion);
+      put64(record + 16, nextSequence);
+      put64(record + 24, beginCrc);
+      put64(record + 32, digest);
+      put32(record + 40, uint32_t(nextSlot));
+      put32(record + 44, kind);
+      put64(record + 48, crc64(record, 48));
+    }
+    if (!ops.write(slotStart + 1 + kPagesPerTransaction, 1, commit) ||
+        !ops.sync()) {
+      fail();
+      lastFault = 6;
+      return false;
+    }
+
+    if (kind == kTransactionKindReset) {
+      memset(bitmap, 0, size_t(bitmapBlocksForValue()) * kBlock);
+      if (!indexRebuild()) {
+        fail();
+        lastFault = 7;
+        return false;
+      }
+      present = 0;
+    } else {
+      for (uint32_t i = 0; i < count; ++i) {
+        bool added = false;
+        if (!entryPublish(index + i, slotStart + 1 + i, nextSequence,
+                          crc32(bytes + size_t(i) * kBlock, kBlock), &added)) {
+          fail();
+          lastFault = 8;
+          return false;
+        }
+        if (added && !rawHas(index + i)) ++present;
+        atomicOrByte(&bitmap[(index + i) >> 3],
+                     uint8_t(1U << ((index + i) & 7)), kAtomicRelease);
+      }
+    }
+    ++nextSlot;
+    lastSequence = nextSequence++;
+    return true;
+  }
+
+  template <class Ops>
+  bool writeChunk(Ops &ops, uint64_t index, uint32_t count, const void *data)
+  {
+    return appendTransactionUnlocked(ops, index, count, data,
+                                     kTransactionKindNormal);
+  }
+
+  template <class Ops>
+  bool writePages(Ops &ops, uint64_t index, uint32_t count, const void *data)
+  {
+    if (!count || index >= pages || count > pages - index) return false;
+    while (count) {
+      lockWordWait(&operationLock);
+      const uint32_t chunk =
+          count > kPagesPerTransaction ? kPagesPerTransaction : count;
+      const bool ok = writeChunk(ops, index, chunk, data);
+      unlockWord(&operationLock);
+      if (!ok) return false;
+      index += chunk;
+      count -= chunk;
+      data = static_cast<const uint8_t *>(data) + size_t(chunk) * kBlock;
+    }
+    return true;
+  }
+
+  template <class Ops>
+  bool resetTransaction(Ops &ops)
+  {
+    if (!active || readOnly || inconsistent) return false;
+    lockWordWait(&operationLock);
+    if (!checkpointCapable) {
+      unlockWord(&operationLock);
+      fail();
+      return false;
+    }
+    bool ok = appendTransactionUnlocked(ops, 0, 0, nullptr,
+                                        kTransactionKindReset);
+    if (ok) ok = checkpointUnlocked(ops);
+    unlockWord(&operationLock);
+    if (!ok) fail();
+    return ok;
+  }
+
+  template <class Ops>
+  bool initializeCheckpointStore(Ops &ops, uint64_t pageCount,
+                                 const uint8_t seed[32], bool ro,
+                                 uint8_t *bits, Entry *table,
+                                 uint32_t tableCapacity,
+                                 uint64_t requestedWalBlocks)
+  {
+    if (ro || !bits || !table || !tableCapacity ||
+        !layoutFor(pageCount, requestedWalBlocks, &layout)) {
+      fail();
+      return false;
+    }
+    pages = pageCount;
+    bitmap = bits;
+    entries = table;
+    entryCapacity = tableCapacity;
+    walStart = layout.walStart;
+    walBlocks = layout.walBlocks;
+    slotCount = walBlocks / kTransactionBlocks;
+    checkpointCapable = true;
+    readOnly = false;
+    active = true;
+    inconsistent = false;
+    present = 0;
+    memset(bitmap, 0, size_t(bitmapBlocksForValue()) * kBlock);
+    if (!indexRebuild()) {
+      fail();
+      return false;
+    }
+    memcpy(seedCopy, seed, 32);
+    checkpointBank = kSnapshotBankA;
+    checkpointGeneration = 1;
+    baseSequence = lastSequence = 1;
+    nextSequence = 2;
+    walHeadSlot = 0;
+    walHeadSequence = 2;
+    if (!writeSnapshotUnlocked(ops, checkpointBank, baseSequence,
+                               checkpointGeneration)) {
+      fail();
+      return false;
+    }
+    uint8_t rootA[kBlock], rootB[kBlock];
+    encodeRoot(rootA, pages, seedCopy, baseSequence, checkpointGeneration,
+               walStart, walBlocks, checkpointBank, layout.snapshotBlocks,
+               layout.baseStart, layout.baseBlocks, walHeadSlot);
+    encodeRoot(rootB, pages, seedCopy, baseSequence, checkpointGeneration,
+               walStart, walBlocks, checkpointBank, layout.snapshotBlocks,
+               layout.baseStart, layout.baseBlocks, walHeadSlot);
+    if (!ops.write(kRootSlotB, 1, rootB) || !ops.sync() ||
+        !ops.write(kRootSlotA, 1, rootA) || !ops.sync() ||
+        !clearWalUnlocked(ops)) {
+      fail();
+      return false;
+    }
+    return true;
+  }
+
+  template <class Ops>
+  bool readRoots(Ops &ops, uint64_t pageCount, const uint8_t seed[32],
+                 bool ro, uint8_t *bits, Entry *table, uint32_t tableCapacity,
+                 uint64_t requestedWalBlocks, bool reset, bool initialize)
+  {
+    pages = pageCount;
+    bitmap = bits;
+    entries = table;
+    entryCapacity = tableCapacity;
+    active = false;
+    readOnly = ro;
+    inconsistent = false;
+    checkpointCapable = false;
+    checkpointFailed = false;
+    present = 0;
+    lastSequence = baseSequence = 0;
+    nextSlot = walHeadSlot = 0;
+    recoveredCommittedTail = false;
+    stoppedAtUncommittedTail = false;
+    spaceExhausted = false;
+    if (initialize) {
+      if (!initializeCheckpointStore(ops, pageCount, seed, ro, bits, table,
+                                     tableCapacity, requestedWalBlocks)) {
+        return false;
+      }
+      if (reset) return true;
+      fail();
+      return false;
+    }
+    if (!pages || !bitmap || !entries || !entryCapacity ||
+        !requestedWalBlocks) {
+      fail();
+      return false;
+    }
+
+    uint8_t rootBlockA[kBlock], rootBlockB[kBlock];
+    if (!ops.read(kRootSlotA, 1, rootBlockA) ||
+        !ops.read(kRootSlotB, 1, rootBlockB)) {
+      fail();
+      return false;
+    }
+    Root rootA, rootB;
+    const bool validA = decodeRoot(rootBlockA, pages, seed, &rootA);
+    const bool validB = decodeRoot(rootBlockB, pages, seed, &rootB);
+    if (!validA && !validB) {
+      fail();
+      return false;
+    }
+    if (validA && validB &&
+        rootA.checkpointGeneration == rootB.checkpointGeneration &&
+        (rootA.flags != rootB.flags ||
+         rootA.snapshotBank != rootB.snapshotBank ||
+         rootA.baseSequence != rootB.baseSequence ||
+         rootA.walStart != rootB.walStart ||
+         rootA.walBlocks != rootB.walBlocks ||
+         rootA.walHeadSlot != rootB.walHeadSlot)) {
+      fail();
+      return false;
+    }
+    const Root &root =
+        validB && (!validA ||
+                   rootB.checkpointGeneration > rootA.checkpointGeneration)
+            ? rootB : rootA;
+    checkpointCapable = root.flags == kRootFlagsCheckpoint;
+    const bool layoutOk = checkpointCapable
+                              ? layoutFor(pages, requestedWalBlocks, &layout)
+                              : legacyLayoutFor(pages, requestedWalBlocks, &layout);
+    if (!layoutOk || root.walStart != layout.walStart ||
+        root.walBlocks != layout.walBlocks) {
+      fail();
+      return false;
+    }
+    if (checkpointCapable &&
+        (root.snapshotBlocks != layout.snapshotBlocks ||
+         root.baseStart != layout.baseStart ||
+         root.baseBlocks != layout.baseBlocks ||
+         root.walHeadSlot >= slotCountFor(root.walBlocks))) {
+      fail();
+      return false;
+    }
+
+    walStart = root.walStart;
+    walBlocks = root.walBlocks;
+    slotCount = walBlocks / kTransactionBlocks;
+    checkpointBank = root.snapshotBank;
+    checkpointGeneration = root.checkpointGeneration;
+    baseSequence = lastSequence = root.baseSequence;
+    walHeadSlot = root.walHeadSlot;
+    walHeadSequence = root.walHeadSequence;
+    memcpy(seedCopy, seed, 32);
+    if (!indexRebuild()) {
+      fail();
+      return false;
+    }
+    if (checkpointCapable) {
+      active = true;
+      if (!loadSnapshotUnlocked(ops, checkpointBank, root.snapshotSequence,
+                                checkpointGeneration)) {
+        fail();
+        return false;
+      }
+    } else {
+      present = 0;
+      memset(bitmap, 0, size_t(bitmapBlocksForValue()) * kBlock);
+    }
+
+    uint8_t begin[kBlock], commit[kBlock], pageData[kBlock];
+    uint64_t scanned = 0;
+    for (; scanned < slotCount; ++scanned) {
+      const uint64_t slot = (walHeadSlot + scanned) % slotCount;
+      const uint64_t slotOffset = slot * kTransactionBlocks;
+      const uint64_t slotStart = walStart + slotOffset;
+      if (!ops.read(slotStart, 1, begin)) {
+        fail();
+        return false;
+      }
+      if (allZero(begin, sizeof begin)) {
+        nextSlot = slot;
+        stoppedAtUncommittedTail = true;
+        break;
+      }
+      if (memcmp(begin, "SHNGV2JB", 8) ||
+          get32(begin + 8) != kVersion ||
+          get32(begin + 12) != kBeginBytes ||
+          get64(begin + 64) != pages ||
+          memcmp(begin + 32, seed, 32) ||
+          get64(begin + 320) != crc64(begin, 320)) {
+        if (scanned == 0 || get64(begin + 16) <= baseSequence) {
+          nextSlot = slot;
+          stoppedAtUncommittedTail = true;
+          break;
+        }
+        fail();
+        return false;
+      }
+      const uint64_t sequence = get64(begin + 16);
+      const uint32_t count = get32(begin + 72);
+      const uint32_t kind = get32(begin + 76);
+      if (sequence <= baseSequence) {
+        nextSlot = slot;
+        stoppedAtUncommittedTail = true;
+        break;
+      }
+      if (lastSequence == UINT64_MAX || sequence != lastSequence + 1 ||
+          get64(begin + 24) != lastSequence ||
+          get32(begin + 80) != uint32_t(slot) ||
+          !allZero(begin + 84, 44) ||
+          !allZero(begin + 328, kBlock - 328) ||
+          (kind == kTransactionKindNormal &&
+           (count < 1 || count > kPagesPerTransaction)) ||
+          (kind == kTransactionKindReset && count != 0) ||
+          (kind != kTransactionKindNormal &&
+           kind != kTransactionKindReset)) {
+        fail();
+        return false;
+      }
+      if (kind == kTransactionKindNormal &&
+          (!allZero(begin + 128 + size_t(count) * 24,
+                    size_t(kPagesPerTransaction - count) * 24))) {
+        nextSlot = slot;
+        stoppedAtUncommittedTail = true;
+        break;
+      }
+      if (kind == kTransactionKindReset &&
+          !allZero(begin + 128, size_t(kPagesPerTransaction) * 24)) {
+        fail();
+        return false;
+      }
+
+      if (!ops.read(slotStart + 1 + kPagesPerTransaction, 1, commit)) {
+        fail();
+        return false;
+      }
+      uint8_t firstRecord[64], secondRecord[64];
+      memcpy(firstRecord, commit, sizeof firstRecord);
+      memcpy(secondRecord, commit + kCommitCopyOffset, sizeof secondRecord);
+      const bool firstValid =
+          !memcmp(firstRecord, "SHNGV2JC", 8) &&
+          get32(firstRecord + 8) == kVersion &&
+          get64(firstRecord + 16) == sequence &&
+          get64(firstRecord + 24) == get64(begin + 320) &&
+          get32(firstRecord + 40) == uint32_t(slot) &&
+          get32(firstRecord + 44) == kind &&
+          get64(firstRecord + 48) == crc64(firstRecord, 48);
+      const bool secondValid =
+          !memcmp(secondRecord, "SHNGV2JC", 8) &&
+          get32(secondRecord + 8) == kVersion &&
+          get64(secondRecord + 16) == sequence &&
+          get64(secondRecord + 24) == get64(begin + 320) &&
+          get32(secondRecord + 40) == uint32_t(slot) &&
+          get32(secondRecord + 44) == kind &&
+          get64(secondRecord + 48) == crc64(secondRecord, 48);
+      if (!firstValid || !secondValid ||
+          memcmp(firstRecord, secondRecord, 56) ||
+          !allZero(commit + 56, kCommitCopyOffset - 56) ||
+          !allZero(commit + kCommitCopyOffset + 56,
+                   kCommitCopyOffset - 56)) {
+        nextSlot = slot;
+        stoppedAtUncommittedTail = true;
+        break;
+      }
+
+      uint64_t digestState = crc64Update(crc64Init(), begin, sizeof begin);
+      if (kind == kTransactionKindReset) {
+        memset(bitmap, 0, size_t(bitmapBlocksForValue()) * kBlock);
+        if (!indexRebuild()) {
+          fail();
+          return false;
+        }
+        present = 0;
+      } else {
+        uint32_t processed = 0;
+        for (; processed < count; ++processed) {
+          const uint8_t *descriptor = begin + 128 + processed * 24;
+          const uint64_t logical = get64(descriptor);
+          bool duplicate = false;
+          for (uint32_t previous = 0; previous < processed; ++previous)
+            if (get64(begin + 128 + previous * 24) == logical)
+              duplicate = true;
+          if (logical >= pages || duplicate ||
+              get32(descriptor + 8) != processed + 1 ||
+              !allZero(descriptor + 16, 8) ||
+              !ops.read(slotStart + 1 + processed, 1, pageData)) {
+            nextSlot = slot;
+            stoppedAtUncommittedTail = true;
+            break;
+          }
+          const uint32_t checksum = crc32(pageData, sizeof pageData);
+          if (checksum != get32(descriptor + 12)) {
+            nextSlot = slot;
+            stoppedAtUncommittedTail = true;
+            break;
+          }
+          digestState =
+              crc64Update(digestState, pageData, sizeof pageData);
+        }
+        if (processed != count) break;
+        if (crc64Finish(digestState) != get64(firstRecord + 32)) {
+          nextSlot = slot;
+          stoppedAtUncommittedTail = true;
+          break;
+        }
+        for (uint32_t processedAgain = 0; processedAgain < count;
+             ++processedAgain) {
+          const uint8_t *descriptor =
+              begin + 128 + processedAgain * 24;
+          bool added = false;
+          if (!entryPublish(get64(descriptor),
+                            slotStart + 1 + processedAgain, sequence,
+                            get32(descriptor + 12), &added)) {
+            fail();
+            return false;
+          }
+          if (added && !rawHas(get64(descriptor))) ++present;
+          atomicOrByte(&bitmap[get64(descriptor) >> 3],
+                       uint8_t(1U << (get64(descriptor) & 7)),
+                       kAtomicRelease);
+        }
+      }
+      lastSequence = sequence;
+      recoveredCommittedTail = true;
+    }
+    if (scanned == slotCount) {
+      nextSlot = walHeadSlot;
+      spaceExhausted = true;
+    }
+    if (!verifyEffectiveUnlocked(ops)) {
+      fail();
+      return false;
+    }
+    if (lastSequence >= UINT64_MAX - 1) {
+      fail();
+      return false;
+    }
+    nextSequence = lastSequence + 1;
+    active = true;
+    readOnly = ro;
+    if (reset) {
+      if (!checkpointCapable || !resetTransaction(ops)) {
+        fail();
+        return false;
+      }
+    }
+    return true;
+  }
+
+  template <class Ops, class Load>
+  bool forEachPresent(Ops &ops, Load &load, uint8_t *scratch, uint32_t maxRun)
+  {
+    if (!active || !scratch || !maxRun) return false;
+    for (uint64_t i = 0; i < pages; ++i) {
+      if (!has(i)) continue;
+      if (!readPage(ops, i, scratch)) return false;
+      if (!load(i, scratch)) return false;
+    }
+    return true;
+  }
+
+  uint64_t bitmapBlocksForValue() const
+  {
+    uint64_t blocks = 0;
+    return bitmapBlocksFor(pages, &blocks) ? blocks : 0;
+  }
+
+  static uint64_t slotCountFor(uint64_t blocks)
+  {
+    return blocks / kTransactionBlocks;
+  }
+
+  uint8_t seedCopy[32] = {};
+};
+
+inline uint64_t bitmapBlocks(uint64_t pages)
+{
+  uint64_t value = 0;
+  return bitmapBlocksFor(pages, &value) ? value : 0;
+}
+
+inline bool windowBlocksFor(uint64_t pages, uint64_t walBlocks, uint64_t *blocks)
+{
+  Layout layout;
+  if (!blocks || !layoutFor(pages, walBlocks, &layout)) return false;
+  *blocks = layout.windowBlocks;
+  return true;
+}
