+  bool entryCanAccept(uint64_t index, uint32_t count) const
+  {
+    if (!entries || !entryCapacity) return false;
+    uint32_t needed = 0;
+    for (uint32_t i = 0; i < count; ++i) {
+      Entry *found = nullptr;
+      if (!entryFind(index + i, &found, nullptr)) return false;
+      if (found) continue;
+      bool duplicate = false;
+      for (uint32_t j = 0; j < i; ++j)
