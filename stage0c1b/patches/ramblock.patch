+constexpr uint32_t kVersion = 2;
+constexpr uint32_t kBlock = 4096;
+constexpr uint32_t kPagesPerTransaction = 8;
+constexpr uint32_t kRootBytesLegacy = 128;
+constexpr uint32_t kRootBytesCheckpoint = 208;
+constexpr uint32_t kBeginBytes = 336;
+constexpr uint32_t kRootFlagsNoCheckpoint = 0;
+constexpr uint32_t kRootFlagsCheckpoint = 1;
+constexpr uint32_t kRootSlotA = 0;
+constexpr uint32_t kRootSlotB = 1;
+constexpr uint32_t kRootSlots = 2;
+constexpr uint32_t kSnapshotHeaderBlocks = 1;
+constexpr uint32_t kTransactionKindNormal = 0;
+constexpr uint32_t kTransactionKindReset = 1;
+constexpr uint32_t kSnapshotBankA = 0;
+constexpr uint32_t kSnapshotBankB = 1;
+constexpr uint32_t kCommitCopyOffset = kBlock / 2;
+constexpr uint32_t kTransactionBlocks = 1 + kPagesPerTransaction + 1;
+#if defined(_MSC_VER)
+constexpr int kAtomicRelaxed = 0;
+constexpr int kAtomicAcquire = 1;
+constexpr int kAtomicRelease = 2;
+#else
+constexpr int kAtomicRelaxed = __ATOMIC_RELAXED;
+constexpr int kAtomicAcquire = __ATOMIC_ACQUIRE;
+constexpr int kAtomicRelease = __ATOMIC_RELEASE;
+#endif
+
+inline void put32(uint8_t *p, uint32_t value)
+{
+  for (unsigned i = 0; i < 4; ++i) p[i] = uint8_t(value >> (8 * i));
+}
+
+inline void put64(uint8_t *p, uint64_t value)
+{
+  for (unsigned i = 0; i < 8; ++i) p[i] = uint8_t(value >> (8 * i));
+}
+
+inline uint32_t get32(const uint8_t *p)
+{
+  uint32_t value = 0;
+  for (int i = 3; i >= 0; --i) value = (value << 8) | p[i];
+  return value;
+}
+
+inline uint64_t get64(const uint8_t *p)
+{
+  uint64_t value = 0;
+  for (int i = 7; i >= 0; --i) value = (value << 8) | p[i];
+  return value;
+}
+
+inline uint32_t crc32(const uint8_t *data, size_t bytes)
+{
+  uint32_t crc = 0xffffffffU;
+  for (size_t i = 0; i < bytes; ++i) {
+    crc ^= data[i];
+    for (unsigned bit = 0; bit < 8; ++bit)
+      crc = (crc >> 1) ^ (0xedb88320U & (0U - (crc & 1U)));
+  }
+  return ~crc;
+}
+
+inline uint64_t crc64Init()
+{
+  return UINT64_MAX;
+}
+
+inline uint64_t crc64Update(uint64_t crc, const uint8_t *data, size_t bytes)
+{
+  for (size_t i = 0; i < bytes; ++i) {
+    crc ^= data[i];
+    for (unsigned bit = 0; bit < 8; ++bit)
+      crc = (crc >> 1) ^ (0xc96c5795d7870f42ULL & (0ULL - (crc & 1ULL)));
+  }
+  return crc;
+}
+
+inline uint64_t crc64Finish(uint64_t crc)
+{
+  return ~crc;
+}
+
+inline uint64_t crc64(const uint8_t *data, size_t bytes)
+{
+  return crc64Finish(crc64Update(crc64Init(), data, bytes));
+}
+
+inline bool allZero(const uint8_t *data, size_t bytes)
+{
+  if (!data) return false;
+  for (size_t i = 0; i < bytes; ++i)
+    if (data[i]) return false;
+  return true;
+}
+
+inline uint8_t atomicLoadByte(const uint8_t *p, int acquire)
+{
+#if defined(_MSC_VER)
+  (void) acquire;
+  return *const_cast<volatile const uint8_t *>(p);
+#else
+  return __atomic_load_n(p, acquire);
+#endif
+}
+
+inline void atomicStoreByte(uint8_t *p, uint8_t value, int release)
+{
+#if defined(_MSC_VER)
+  (void) release;
+  *const_cast<volatile uint8_t *>(p) = value;
+#else
+  __atomic_store_n(p, value, release);
+#endif
+}
+
+inline uint8_t atomicOrByte(uint8_t *p, uint8_t value, int release)
+{
+#if defined(_MSC_VER)
+  (void) release;
+  return uint8_t(_InterlockedOr8(reinterpret_cast<volatile char *>(p), value));
+#else
+  return __atomic_fetch_or(p, value, release);
+#endif
+}
+
+inline bool lockWord(volatile uint32_t *word)
+{
+#if defined(_MSC_VER)
+  return _InterlockedCompareExchange(reinterpret_cast<volatile long *>(word), 1, 0) == 0;
+#else
+  uint32_t expected = 0;
+  return __atomic_compare_exchange_n(
+      const_cast<uint32_t *>(word), &expected, 1, false, __ATOMIC_ACQUIRE, __ATOMIC_RELAXED);
+#endif
+}
+
+inline void unlockWord(volatile uint32_t *word)
+{
+#if defined(_MSC_VER)
+  _InterlockedExchange(reinterpret_cast<volatile long *>(word), 0);
+#else
+  __atomic_store_n(const_cast<uint32_t *>(word), 0, __ATOMIC_RELEASE);
+#endif
+}
+
+inline void lockWordWait(volatile uint32_t *word)
+{
+  while (!lockWord(word)) {
+#if defined(_MSC_VER)
+    _mm_pause();
+#endif
+  }
+}
+
+inline bool checkedAdd(uint64_t a, uint64_t b, uint64_t *out)
+{
+  if (!out || a > UINT64_MAX - b) return false;
+  *out = a + b;
+  return true;
+}
+
+inline bool checkedMul(uint64_t a, uint64_t b, uint64_t *out)
+{
+  if (!out || (a && b > UINT64_MAX / a)) return false;
+  *out = a * b;
+  return true;
+}
+
+inline bool bitmapBlocksFor(uint64_t pages, uint64_t *blocks)
+{
+  if (!blocks || !pages) return false;
+  *blocks = 1 + (pages - 1) / (kBlock * 8ULL);
+  return true;
+}
+
+inline bool checksumBlocksFor(uint64_t pages, uint64_t *blocks)
+{
+  if (!blocks || !pages) return false;
+  uint64_t bytes = 0;
+  if (!checkedMul(pages, 4, &bytes)) return false;
+  *blocks = 1 + (bytes - 1) / kBlock;
+  return true;
+}
+
+inline bool snapshotBlocksFor(uint64_t pages, uint64_t *blocks)
+{
+  uint64_t bitmap = 0, checksums = 0, total = 0;
+  if (!bitmapBlocksFor(pages, &bitmap) ||
+      !checksumBlocksFor(pages, &checksums) ||
+      !checkedAdd(kSnapshotHeaderBlocks, bitmap, &total) ||
+      !checkedAdd(total, checksums, &total)) {
+    return false;
+  }
+  *blocks = total;
+  return true;
+}
+
+struct Layout {
+  uint64_t snapshotBlocks = 0;
+  uint64_t snapshotStartA = 0;
+  uint64_t snapshotStartB = 0;
+  uint64_t baseStart = 0;
+  uint64_t baseBlocks = 0;
+  uint64_t walStart = 0;
+  uint64_t walBlocks = 0;
+  uint64_t windowBlocks = 0;
+};
+
+inline bool layoutFor(uint64_t pages, uint64_t walBlocks, Layout *layout)
+{
+  if (!layout || !pages || !walBlocks ||
+      walBlocks % kTransactionBlocks != 0) return false;
+  uint64_t snapshotEach = 0, snapshotsTotal = 0, baseStart = 0;
+  uint64_t walStart = 0, window = 0;
+  if (!snapshotBlocksFor(pages, &snapshotEach) ||
+      !checkedMul(snapshotEach, 2, &snapshotsTotal) ||
+      !checkedAdd(kRootSlots, snapshotsTotal, &baseStart) ||
+      !checkedAdd(baseStart, pages, &walStart) ||
+      !checkedAdd(walStart, walBlocks, &window)) {
+    return false;
+  }
+  layout->snapshotBlocks = snapshotEach;
+  layout->snapshotStartA = kRootSlots;
+  layout->snapshotStartB = kRootSlots + snapshotEach;
+  layout->baseStart = baseStart;
+  layout->baseBlocks = pages;
+  layout->walStart = walStart;
+  layout->walBlocks = walBlocks;
+  layout->windowBlocks = window;
+  return true;
+}
+
+// Stage 0B-2B-2A fixtures and any explicitly created WAL-only v2 image keep
+// their original geometry. They are readable, but do not claim checkpoint
+// safety and are not silently upgraded.
+inline bool legacyLayoutFor(uint64_t pages, uint64_t walBlocks, Layout *layout)
+{
+  if (!layout || !pages || !walBlocks ||
+      walBlocks % kTransactionBlocks != 0) return false;
+  uint64_t snapshotEach = 0, snapshotsTotal = 0, walStart = 0, window = 0;
+  if (!snapshotBlocksFor(pages, &snapshotEach) ||
+      !checkedMul(snapshotEach, 2, &snapshotsTotal) ||
+      !checkedAdd(kRootSlots, snapshotsTotal, &walStart) ||
+      !checkedAdd(walStart, walBlocks, &window)) {
+    return false;
+  }
+  layout->snapshotBlocks = snapshotEach;
+  layout->snapshotStartA = kRootSlots;
+  layout->snapshotStartB = kRootSlots + snapshotEach;
+  layout->baseStart = 0;
+  layout->baseBlocks = 0;
+  layout->walStart = walStart;
+  layout->walBlocks = walBlocks;
+  layout->windowBlocks = window;
+  return true;
+}
+
+struct Root {
+  uint32_t flags = kRootFlagsNoCheckpoint;
+  uint32_t snapshotBank = 0;
+  uint64_t baseSequence = 0;
+  uint64_t checkpointGeneration = 0;
+  uint64_t walStart = 0;
+  uint64_t walBlocks = 0;
+  uint64_t pages = 0;
+  uint64_t snapshotSequence = 0;
+  uint64_t snapshotBlocks = 0;
+  uint64_t baseStart = 0;
+  uint64_t baseBlocks = 0;
+  uint64_t walHeadSlot = 0;
+  uint64_t walHeadSequence = 0;
+  uint8_t seed[32] = {};
+};
+
+inline void encodeLegacyRoot(uint8_t block[kBlock], uint64_t pages,
+                             const uint8_t seed[32], uint64_t baseSequence,
+                             uint64_t walStart, uint64_t walBlocks)
+{
+  memset(block, 0, kBlock);
+  memcpy(block, "SHNGV2RT", 8);
+  put32(block + 8, kVersion);
+  put32(block + 12, kRootBytesLegacy);
+  put32(block + 16, kRootFlagsNoCheckpoint);
+  put32(block + 20, 0);
+  memcpy(block + 24, seed, 32);
+  put64(block + 56, pages);
+  put64(block + 64, baseSequence);
+  put64(block + 72, 0);
+  put64(block + 80, walStart);
+  put64(block + 88, walBlocks);
+  put64(block + 96, kPagesPerTransaction);
+  put64(block + 104, kTransactionBlocks);
+  put64(block + 112, crc64(block, 112));
+}
+
+inline void encodeRoot(uint8_t block[kBlock], uint64_t pages,
+                       const uint8_t seed[32], uint64_t baseSequence,
+                       uint64_t checkpointGeneration, uint64_t walStart,
+                       uint64_t walBlocks, uint32_t snapshotBank,
+                       uint64_t snapshotBlocks, uint64_t baseStart,
+                       uint64_t baseBlocks, uint64_t walHeadSlot)
+{
+  memset(block, 0, kBlock);
+  memcpy(block, "SHNGV2RT", 8);
+  put32(block + 8, kVersion);
+  put32(block + 12, kRootBytesCheckpoint);
+  put32(block + 16, kRootFlagsCheckpoint);
+  put32(block + 20, snapshotBank + 1);
+  memcpy(block + 24, seed, 32);
+  put64(block + 56, pages);
+  put64(block + 64, baseSequence);
+  put64(block + 72, checkpointGeneration);
+  put64(block + 80, walStart);
+  put64(block + 88, walBlocks);
+  put64(block + 96, kPagesPerTransaction);
+  put64(block + 104, kTransactionBlocks);
+  put64(block + 112, crc64(block, 112));
+  put32(block + 120, snapshotBank);
+  put64(block + 128, baseSequence);
+  put64(block + 136, snapshotBlocks);
+  put64(block + 144, baseStart);
+  put64(block + 152, baseBlocks);
+  put64(block + 160, walHeadSlot);
+  put64(block + 168, baseSequence + 1);
+  put64(block + 176, checkpointGeneration);
+  put64(block + 200, crc64(block, 200));
+}
+
+inline void encodeRoot(uint8_t block[kBlock], uint64_t pages,
+                       const uint8_t seed[32], uint64_t baseSequence,
+                       uint64_t walStart, uint64_t walBlocks)
+{
+  encodeLegacyRoot(block, pages, seed, baseSequence, walStart, walBlocks);
