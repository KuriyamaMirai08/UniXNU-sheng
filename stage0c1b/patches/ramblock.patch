+  candidate.flags = flags;
+  candidate.pages = get64(block + 56);
+  candidate.baseSequence = get64(block + 64);
+  candidate.walStart = get64(block + 80);
+  candidate.walBlocks = get64(block + 88);
+  memcpy(candidate.seed, block + 24, 32);
+  if (candidate.pages != pages || memcmp(candidate.seed, seed, 32) ||
+      !candidate.baseSequence || candidate.baseSequence == UINT64_MAX ||
+      !candidate.walBlocks || candidate.walBlocks % kTransactionBlocks) {
+    return false;
+  }
+  if (flags == kRootFlagsNoCheckpoint && bytes == kRootBytesLegacy &&
+      get32(block + 20) == 0 && get64(block + 72) == 0 &&
+      allZero(block + 120, kBlock - 120)) {
+    candidate.checkpointGeneration = candidate.baseSequence;
+    candidate.walHeadSlot = 0;
+    candidate.walHeadSequence = candidate.baseSequence + 1;
+    *root = candidate;
+    return true;
+  }
+  if (flags != kRootFlagsCheckpoint || bytes != kRootBytesCheckpoint ||
+      get32(block + 120) > kSnapshotBankB ||
+      get32(block + 20) != get32(block + 120) + 1 ||
+      get64(block + 128) != candidate.baseSequence ||
+      get64(block + 168) != candidate.baseSequence + 1 ||
+      get64(block + 176) != get64(block + 72) ||
+      get64(block + 200) != crc64(block, 200) ||
+      !allZero(block + 184, 16) ||
+      !allZero(block + 208, kBlock - 208)) {
+    return false;
+  }
+  candidate.snapshotBank = get32(block + 120);
+  candidate.snapshotSequence = get64(block + 128);
+  candidate.snapshotBlocks = get64(block + 136);
+  candidate.baseStart = get64(block + 144);
+  candidate.baseBlocks = get64(block + 152);
+  candidate.walHeadSlot = get64(block + 160);
+  candidate.walHeadSequence = get64(block + 168);
+  candidate.checkpointGeneration = get64(block + 72);
+  if (!candidate.checkpointGeneration ||
+      candidate.checkpointGeneration == UINT64_MAX ||
+      candidate.snapshotSequence != candidate.baseSequence ||
+      !candidate.snapshotBlocks || !candidate.baseBlocks) {
+    return false;
+  }
+  *root = candidate;
+  return true;
+}
+
+inline bool isRootMagic(const uint8_t block[kBlock])
+{
+  return memcmp(block, "SHNGV2RT", 8) == 0;
+}
