+struct Entry {
+  uint64_t page = 0;
+  uint64_t dataBlock = 0;
+  uint64_t sequence = 0;
+  uint32_t checksum = 0;
+  uint8_t active = 0;
+  uint8_t reserved[3] = {};
+};
+
+enum class OpenResult {
+  Failed,
+  Initialized,
+  Recovered,
+  ReadOnly
+};
