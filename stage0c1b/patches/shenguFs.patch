+  0x8e, 0x79, 0x3d, 0x69, 0xd8, 0x47, 0x7d, 0xe4
+};
+
+static bool establish(bool valid = true)
+{
+  ufsWriteAuthorityReset();
+  const uint64_t backup = valid ? 999999 : 999998;
+  const uint32_t backupEntriesCrc = valid ? 0x22223333 : 0x33334444;
+  return ufsWriteAuthorityEstablish(1000000, 100, 900000, 200, backup, 999996,
+                                    0x11112222, 0x22223333, 0xaaaabbbb, backupEntriesCrc, 7,
+                                    diskGuid, kUfsDarwinTypeGuid, partitionGuid);
+}
+
+static bool registerRoles()
+{
+  return ufsWriteAuthorityRegister(UfsWriteRole::Data, 300, 100) &&
+         ufsWriteAuthorityRegister(UfsWriteRole::Export, 800, 100) &&
+         ufsWriteAuthorityRegister(UfsWriteRole::Log, 900, 100);
+}
+
+static void pass(const char *name) { std::printf("PASS: %s\n", name); }
+
+int main()
+{
+  assert(gUfsWriteAuthority.state == UfsWriteState::Sealed);
+  assert(!ufsWriteAuthorityAllows(UfsWriteRole::Data, 0, 300, 1));
+  pass("deny by default before root verification");
+
+  assert(establish());
+  assert(gUfsWriteAuthority.state == UfsWriteState::Ready);
+  assert(!ufsWriteAuthorityAllows(UfsWriteRole::Data, 0, 300, 1));
+  pass("verified base grants no role by default");
+
+  assert(registerRoles());
+  assert(ufsWriteAuthorityAllows(UfsWriteRole::Data, 0, 300, 1));
+  assert(ufsWriteAuthorityAllows(UfsWriteRole::Data, 0, 399, 1));
+  assert(ufsWriteAuthorityAllows(UfsWriteRole::Export, 0, 800, 100));
+  assert(ufsWriteAuthorityAllows(UfsWriteRole::Log, 0, 900, 100));
+  assert(ufsWriteAuthorityAllows(UfsWriteRole::Panic, 0, 950, 50));
+  pass("role windows accept exact boundaries; panic shares log range");
+
+  const uint64_t allowed = gUfsWriteAuthority.allowedWrites;
+  assert(!ufsWriteAuthorityAllows(UfsWriteRole::Data, 0, 299, 1));
+  assert(!ufsWriteAuthorityAllows(UfsWriteRole::Data, 0, 398, 3));
+  assert(!ufsWriteAuthorityAllows(UfsWriteRole::Data, 0, 400, 1));
+  assert(!ufsWriteAuthorityAllows(UfsWriteRole::Export, 0, 700, 1));
+  assert(!ufsWriteAuthorityAllows(UfsWriteRole::Log, 0, 950, 51));
+  pass("wrong partizione, boundary overrun and cross-role access rejected");
+  assert(gUfsWriteAuthority.allowedWrites == allowed);
+
+  assert(!ufsWriteAuthorityAllows(UfsWriteRole::Data, 0, 300, 0));
+  assert(!ufsWriteAuthorityAllows(UfsWriteRole::Data, 0, UINT32_MAX, 2));
+  assert(!ufsWriteAuthorityAllows(UfsWriteRole::None, 0, 300, 1));
+  pass("zero, overflow and no-role requests rejected");
+
+  const uint64_t denied = gUfsWriteAuthority.deniedWrites;
+  assert(!ufsWriteAuthorityAllows(UfsWriteRole::Data, 1, 300, 1));
+  assert(gUfsWriteAuthority.deniedWrites > denied);
+  pass("non-LUN-0 request rejected");
+
+  assert(!ufsWriteAuthorityRegister(UfsWriteRole::Data, 500, 1));
+  assert(!ufsWriteAuthorityRegister(UfsWriteRole::Log, 899, 2));
+  assert(!ufsWriteAuthorityRegister(UfsWriteRole::Export, 901, 1));
+  assert(!ufsWriteAuthorityRegister(UfsWriteRole::Panic, 950, 1));
+  pass("duplicate, overlap, first-past-partition and unassigned panic roles rejected");
+
+  assert(!establish(false));
+  assert(gUfsWriteAuthority.state == UfsWriteState::Sealed);
+  pass("backup header not at UFS last LBA rejected");
+
+  ufsWriteAuthorityReset();
+  assert(!ufsWriteAuthorityEstablish(1000000, 100, 900000, 200, 999999, 999996,
+                                     0x11112222, 0x22223333, 0xaaaabbbb, 0x22223333, 7,
+                                     diskGuid, wrongType, partitionGuid));
+  pass("type GUID contract mismatch rejected");
+
+  ufsWriteAuthorityReset();
+  uint8_t zeroGuid[16] = {};
+  assert(!ufsWriteAuthorityEstablish(1000000, 100, 900000, 200, 999999, 999996,
+                                     0x11112222, 0x22223333, 0xaaaabbbb, 0x22223333, 7,
+                                     diskGuid, kUfsDarwinTypeGuid, zeroGuid));
+  pass("zero partition identity rejected");
+
+  ufsWriteAuthorityReset();
+  assert(!ufsWriteAuthorityEstablish(1000000, 100, 1000000, 200, 999999, 999996,
+                                     0x11112222, 0x22223333, 0xaaaabbbb, 0x22223333, 7,
+                                     diskGuid, kUfsDarwinTypeGuid, partitionGuid));
+  pass("partition outside UFS capacity rejected");
+
+  assert(establish() && ufsWriteAuthorityRegister(UfsWriteRole::Data, 300, 100));
+  ufsWriteAuthorityRevoke(false);
+  assert(gUfsWriteAuthority.state == UfsWriteState::Revoked);
+  assert(!ufsWriteAuthorityAllows(UfsWriteRole::Data, 0, 300, 1));
+  assert(!ufsWriteAuthorityRegister(UfsWriteRole::Log, 900, 100));
+  pass("revocation clears windows and forbids re-registration");
+
+  ufsWriteAuthorityRevoke(true);
+  assert(gUfsWriteAuthority.state == UfsWriteState::Failed);
+  assert(gUfsWriteAuthority.transportFailures == 1);
+  pass("transport failure remains latched");
+
+  std::puts("PASS: deny-by-default UFS write authority, Darwin identity, GPT/capacity baseline, role isolation, bounds and integer overflow");
+}
