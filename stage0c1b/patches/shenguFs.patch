+++ b/UfsWriteAuthority.h
@@ -0,0 +1,505 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+#pragma once
+
+// Deny-by-default authorization for the UFS command layer. Establishing the base binds every
+// later write to the verified darwin GPT identity and controller-reported LUN capacity. Registering
+// a role then grants only that role's checked window. A revoked or failed authority never reopens
+// without a new root-layout verification.
+//
+// Stage 0B-3B concurrency contract. The whole authority object is guarded by one platform lock.
+// Every transition (Establish, Register, Revoke, Reset, in-flight enter/exit) and the
+// check -> WRITE doorbell submit window run under that lock. The lock is therefore the
+// linearization point of "may this WRITE be submitted?" and of "has the authority been
+// withdrawn?": a withdrawal that has linearized (state left Ready) can never be overtaken by a
+// later doorbell, because the writer re-reads the state under the same lock immediately before
+// every ring.
+//
+// The lock used in production is an IOLock installed by the driver (native_ufs installs it in
+// hostBringUp); a host test may install its own lock. When no platform lock is installed a real
+// compare-exchange spinlock is used, so even the standalone unit test has genuine mutual
+// exclusion -- never a no-op and never a plain volatile flag.
+//
+// In-flight I/O. A WRITE whose doorbell has rung is registered as in flight and stays registered
+// until its completion is observed. Software cannot cancel a submitted DMA; the count only gates
+// whether the authority may be re-published. Establish refuses while any I/O is in flight, so a
+// window that might reuse a region with an outstanding transfer is never re-published.
+
+enum class UfsWriteState : uint32_t {
+  Sealed = 0,      // Uninitialized: no verification has run; every write is denied
+  Ready = 1,       // verified base; a write inside a registered role window is allowed
+  Revoked = 2,     // withdrawn; writes denied until a new Reset + Establish
+  Failed = 3,      // a transport/content failure is latched; writes denied
+  Validating = 4,  // verification in progress; writes denied
+  Revoking = 5     // withdrawal under way with I/O still in flight; writes denied
+};
+
+enum class UfsWriteRole : uint32_t {
+  None = 0,
+  Data = 1,
+  Export = 2,
+  Log = 3,
+  Panic = 4
+};
+
+struct UfsWriteAuthority {
+  UfsWriteState state;
+  uint32_t epoch;
+  uint8_t lun;
+  uint8_t reserved[7];
+  uint64_t capacityBlocks;
+  uint64_t partitionFirst, partitionLast;
+  uint64_t protectedFloor;
+  uint64_t backupHeaderLba, backupEntriesLba;
+  uint64_t dataFirst, dataBlocks;
+  uint64_t exportFirst, exportBlocks;
+  uint64_t logFirst, logBlocks;
+  uint32_t primaryHeaderCrc, primaryEntriesCrc;
+  uint32_t backupHeaderCrc, backupEntriesCrc;
+  uint32_t matchedEntry;
+  uint32_t denialReason;
+  uint64_t allowedWrites, deniedWrites, transportFailures;
+  uint8_t diskGuid[16];
+  uint8_t typeGuid[16];
+  uint8_t partitionGuid[16];
+  // Stage 0B-3B: submissions whose doorbell has rung and whose completion has not been observed.
+  uint64_t inflight;
+  uint8_t revokeFailure;    // a Revoking withdrawal that must end in Failed
+  uint8_t reserved2[7];
+};
+
+static const uint8_t kUfsDarwinTypeGuid[16] = {
+  0xaf, 0x3d, 0xc6, 0x0f, 0x83, 0x84, 0x72, 0x47,
+  0x8e, 0x79, 0x3d, 0x69, 0xd8, 0x47, 0x7d, 0xe4
+};
+
+static UfsWriteAuthority gUfsWriteAuthority = {};
+
+// ---- Platform lock ------------------------------------------------------------------------------------------------
+// All fields must be set together, or none. A partial set is rejected and the fallback is used.
+struct UfsAuthorityLockOps {
+  bool (*tryAcquire)(void *context);
+  void (*acquire)(void *context);
+  void (*release)(void *context);
+  void *context;
+};
+
+static UfsAuthorityLockOps gUfsAuthorityLockOps = { nullptr, nullptr, nullptr, nullptr };
+
+static void ufsWriteAuthoritySetLock (const UfsAuthorityLockOps *ops)
+{
+  if (ops && ops->tryAcquire && ops->acquire && ops->release) {
+    gUfsAuthorityLockOps = *ops;
+  } else {
+    gUfsAuthorityLockOps = { nullptr, nullptr, nullptr, nullptr };
+  }
+}
+
+static bool ufsWriteAuthorityHasPlatformLock (void)
+{
+  return gUfsAuthorityLockOps.acquire != nullptr && gUfsAuthorityLockOps.release != nullptr;
+}
+
+// Fallback mutual exclusion: a real test-and-set spinlock over one word. Used only when the
+// platform has not installed its own lock (the standalone host unit test). The kernel installs an
+// IOLock in hostBringUp, so production never spins here.
+static uint32_t gUfsAuthorityWord = 0;
+static bool ufsAuthorityFallbackTry (void)
+{
+#if defined(_MSC_VER)
+  return _InterlockedCompareExchange (reinterpret_cast<volatile long *> (&gUfsAuthorityWord), 1, 0) == 0;
+#else
+  uint32_t expected = 0;
+  return __atomic_compare_exchange_n (&gUfsAuthorityWord, &expected, 1u, false, __ATOMIC_ACQUIRE, __ATOMIC_RELAXED);
+#endif
+}
+static void ufsAuthorityFallbackRelease (void)
+{
+#if defined(_MSC_VER)
+  _InterlockedExchange (reinterpret_cast<volatile long *> (&gUfsAuthorityWord), 0);
+#else
+  __atomic_store_n (&gUfsAuthorityWord, 0u, __ATOMIC_RELEASE);
+#endif
+}
+
+// Relax hint for the fallback spin below. The fallback only runs when no platform lock is
+// installed (the standalone host test, or IOLockAlloc failing in the kernel). It is a correct
+// but busy test-and-set, so the waiter must not spin at full memory pressure: yield on arm64,
+// pause on x86, and a bare compiler barrier elsewhere. No semantic change to the lock itself.
+static void ufsAuthorityFallbackRelax (void)
+{
+#if defined(__clang__) || defined(__GNUC__)
+#if defined(__x86_64__) || defined(__i386__)
+  __asm__ __volatile__ ("pause" ::: "memory");
+#elif defined(__aarch64__) || defined(__arm64__)
+  __asm__ __volatile__ ("yield" ::: "memory");
+#else
+  __asm__ __volatile__ ("" ::: "memory");
+#endif
+#endif
+}
+
+static bool ufsWriteAuthorityTryAcquire (void)
+{
+  if (gUfsAuthorityLockOps.tryAcquire) return gUfsAuthorityLockOps.tryAcquire (gUfsAuthorityLockOps.context);
+  return ufsAuthorityFallbackTry ();
+}
+static void ufsWriteAuthorityAcquire (void)
+{
+  if (gUfsAuthorityLockOps.acquire) { gUfsAuthorityLockOps.acquire (gUfsAuthorityLockOps.context); return; }
+  while (!ufsAuthorityFallbackTry ()) ufsAuthorityFallbackRelax ();
+}
+static void ufsWriteAuthorityRelease (void)
+{
+  if (gUfsAuthorityLockOps.release) { gUfsAuthorityLockOps.release (gUfsAuthorityLockOps.context); return; }
+  ufsAuthorityFallbackRelease ();
+}
+
+// Test-only linearization probes. Production leaves the pointer null (a single predictable branch).
+enum { UfsProbeAfterCheck = 1, UfsProbeAfterDoorbell = 2, UfsProbeSubmitted = 3, UfsProbeAfterRelease = 4 };
+static void (*gUfsAuthorityProbe)(int) = nullptr;
+static void ufsWriteAuthoritySetProbe (void (*probe)(int)) { gUfsAuthorityProbe = probe; }
+static void ufsAuthorityProbe (int point) { if (gUfsAuthorityProbe) gUfsAuthorityProbe (point); }
+
+static bool ufsWriteGuidNonzero (const uint8_t *guid)
+{
+  uint8_t value = 0;
+  for (unsigned i = 0; i < 16; ++i) value |= guid[i];
+  return value != 0;
+}
+
+static bool ufsWriteRangeFitsRead10 (uint64_t first, uint64_t blocks)
+{
+  return blocks && first <= UINT32_MAX && blocks - 1 <= UINT32_MAX - first;
+}
+
+static bool ufsWriteRangesOverlap (uint64_t first, uint64_t blocks, uint64_t otherFirst, uint64_t otherBlocks)
+{
+  return blocks && otherBlocks && first < otherFirst + otherBlocks && otherFirst < first + blocks;
+}
+
+static bool ufsWriteWindow (const UfsWriteAuthority &authority, UfsWriteRole role, uint64_t *first, uint64_t *blocks)
+{
+  switch (role) {
+    case UfsWriteRole::Data:
+      *first = authority.dataFirst; *blocks = authority.dataBlocks; return true;
+    case UfsWriteRole::Export:
+      *first = authority.exportFirst; *blocks = authority.exportBlocks; return true;
+    case UfsWriteRole::Log:
+    case UfsWriteRole::Panic:
+      *first = authority.logFirst; *blocks = authority.logBlocks; return true;
+    default:
+      *first = *blocks = 0;
+      return false;
+  }
+}
+
+static bool ufsWriteAuthorityBaseValid (const UfsWriteAuthority &authority)
+{
+  if (authority.state != UfsWriteState::Ready || authority.lun != 0 || !authority.capacityBlocks ||
+      authority.capacityBlocks > uint64_t (UINT32_MAX) + 1 ||
+      authority.partitionFirst < 2 || authority.partitionLast < authority.partitionFirst ||
+      authority.partitionLast >= authority.capacityBlocks ||
+      authority.protectedFloor < authority.partitionFirst ||
+      authority.protectedFloor > authority.partitionLast + 1 ||
+      authority.backupHeaderLba != authority.capacityBlocks - 1 ||
+      authority.backupEntriesLba <= authority.partitionLast ||
+      authority.backupEntriesLba >= authority.backupHeaderLba ||
+      !ufsWriteRangeFitsRead10 (authority.partitionFirst, authority.partitionLast - authority.partitionFirst + 1) ||
+      authority.primaryEntriesCrc != authority.backupEntriesCrc ||
+      !ufsWriteGuidNonzero (authority.diskGuid) ||
+      !ufsWriteGuidNonzero (authority.partitionGuid) ||
+      memcmp (authority.typeGuid, kUfsDarwinTypeGuid, 16)) {
+    return false;
+  }
+
+  const uint64_t first[3] = { authority.dataFirst, authority.exportFirst, authority.logFirst };
+  const uint64_t blocks[3] = { authority.dataBlocks, authority.exportBlocks, authority.logBlocks };
+  for (unsigned index = 0; index < 3; ++index) {
+    if (!blocks[index]) continue;
+    if (first[index] < authority.protectedFloor || !ufsWriteRangeFitsRead10 (first[index], blocks[index]) ||
+        first[index] > authority.partitionLast ||
+        blocks[index] > authority.partitionLast - first[index] + 1) {
+      return false;
+    }
+    for (unsigned prior = 0; prior < index; ++prior) {
+      if (ufsWriteRangesOverlap (first[index], blocks[index], first[prior], blocks[prior])) return false;
+    }
+  }
+  return true;
+}
+
+static void ufsWriteAuthorityClearRoles (UfsWriteAuthority *authority)
+{
+  authority->dataFirst = authority->dataBlocks = 0;
+  authority->exportFirst = authority->exportBlocks = 0;
+  authority->logFirst = authority->logBlocks = 0;
+}
+
+// Reset to Sealed and bump the epoch. I/O still in flight is preserved so Establish stays refused
+// until every submitted transfer has completed. Callers must not hold the lock.
+static void ufsWriteAuthorityReset (UfsWriteState state = UfsWriteState::Sealed)
+{
+  ufsWriteAuthorityAcquire ();
+  const uint32_t epoch = gUfsWriteAuthority.epoch + 1;
+  const uint64_t inflight = gUfsWriteAuthority.inflight;
+  const uint32_t denialReason = gUfsWriteAuthority.denialReason;
+  gUfsWriteAuthority = {};
+  gUfsWriteAuthority.state = state;
+  gUfsWriteAuthority.epoch = epoch;
+  gUfsWriteAuthority.inflight = inflight;
+  gUfsWriteAuthority.denialReason = denialReason;
+  ufsWriteAuthorityRelease ();
+}
+
+// Begin a withdrawal. Roles are cleared at once so no new write can pass the check. When I/O is
+// still in flight the state is Revoking until the last completion observes the withdrawal; the
+// transition to Revoked/Failed then also happens under the lock in the completion path.
+static void ufsWriteAuthorityRevoke (bool failed)
+{
+  ufsWriteAuthorityAcquire ();
+  if (failed) ++gUfsWriteAuthority.transportFailures;
+  gUfsWriteAuthority.revokeFailure = failed ? 1 : 0;
+  ufsWriteAuthorityClearRoles (&gUfsWriteAuthority);
+  ++gUfsWriteAuthority.epoch;
+  if (gUfsWriteAuthority.inflight) {
+    gUfsWriteAuthority.state = UfsWriteState::Revoking;
+  } else {
+    gUfsWriteAuthority.state = failed ? UfsWriteState::Failed : UfsWriteState::Revoked;
+  }
+  ufsWriteAuthorityRelease ();
+}
+
+static bool ufsWriteAuthorityEstablish (
+  uint64_t capacityBlocks,
+  uint64_t partitionFirst, uint64_t partitionLast,
+  uint64_t protectedFloor,
+  uint64_t backupHeaderLba, uint64_t backupEntriesLba,
+  uint32_t primaryHeaderCrc, uint32_t primaryEntriesCrc,
+  uint32_t backupHeaderCrc, uint32_t backupEntriesCrc,
+  uint32_t matchedEntry,
+  const uint8_t *diskGuid, const uint8_t *typeGuid, const uint8_t *partitionGuid)
+{
+  ufsWriteAuthorityAcquire ();
+  bool ok = false;
+  if (gUfsWriteAuthority.state != UfsWriteState::Sealed || gUfsWriteAuthority.inflight || !capacityBlocks ||
+      capacityBlocks > uint64_t (UINT32_MAX) + 1 || !diskGuid || !typeGuid || !partitionGuid ||
+      partitionFirst < 2 || partitionLast < partitionFirst || partitionLast >= capacityBlocks ||
+      protectedFloor < partitionFirst || protectedFloor > partitionLast + 1 ||
+      backupHeaderLba != capacityBlocks - 1 || backupEntriesLba <= partitionLast ||
+      backupEntriesLba >= backupHeaderLba ||
+      primaryEntriesCrc != backupEntriesCrc ||
+      !ufsWriteGuidNonzero (diskGuid) || !ufsWriteGuidNonzero (partitionGuid) ||
+      memcmp (typeGuid, kUfsDarwinTypeGuid, 16)) {
+    gUfsWriteAuthority.denialReason = 1;
+  } else {
+    UfsWriteAuthority next = {};
+    next.state = UfsWriteState::Ready;
+    next.capacityBlocks = capacityBlocks;
+    next.partitionFirst = partitionFirst;
+    next.partitionLast = partitionLast;
+    next.protectedFloor = protectedFloor;
+    next.backupHeaderLba = backupHeaderLba;
+    next.backupEntriesLba = backupEntriesLba;
+    next.primaryHeaderCrc = primaryHeaderCrc;
+    next.primaryEntriesCrc = primaryEntriesCrc;
+    next.backupHeaderCrc = backupHeaderCrc;
+    next.backupEntriesCrc = backupEntriesCrc;
+    next.matchedEntry = matchedEntry;
+    memcpy (next.diskGuid, diskGuid, 16);
+    memcpy (next.typeGuid, typeGuid, 16);
+    memcpy (next.partitionGuid, partitionGuid, 16);
+    if (!ufsWriteAuthorityBaseValid (next)) {
+      gUfsWriteAuthority.denialReason = 1;
+    } else {
+      next.epoch = gUfsWriteAuthority.epoch + 1;
+      gUfsWriteAuthority = next;
+      ok = true;
+    }
+  }
+  ufsWriteAuthorityRelease ();
+  return ok;
+}
+
+// Locked core: the caller holds the authority lock. Registers one role window if it fits the
+// verified base and does not overlap an already registered role.
+static bool ufsWriteAuthorityRegisterLocked (UfsWriteRole role, uint64_t first, uint64_t blocks)
+{
+  bool ok = false;
+  if (!ufsWriteAuthorityBaseValid (gUfsWriteAuthority) || role == UfsWriteRole::None || role == UfsWriteRole::Panic ||
+      !blocks || first < gUfsWriteAuthority.protectedFloor || !ufsWriteRangeFitsRead10 (first, blocks) ||
+      first > gUfsWriteAuthority.partitionLast ||
+      blocks > gUfsWriteAuthority.partitionLast - first + 1) {
+    ++gUfsWriteAuthority.deniedWrites;
+    gUfsWriteAuthority.denialReason = 2;
+  } else {
+    uint64_t oldFirst, oldBlocks;
+    if (!ufsWriteWindow (gUfsWriteAuthority, role, &oldFirst, &oldBlocks) || oldBlocks) {
+      ++gUfsWriteAuthority.deniedWrites;
+      gUfsWriteAuthority.denialReason = 3;
+    } else {
+      const UfsWriteRole roles[3] = { UfsWriteRole::Data, UfsWriteRole::Export, UfsWriteRole::Log };
+      bool overlap = false;
+      for (UfsWriteRole other : roles) {
+        uint64_t otherFirst, otherBlocks;
+        ufsWriteWindow (gUfsWriteAuthority, other, &otherFirst, &otherBlocks);
+        if (other != role && ufsWriteRangesOverlap (first, blocks, otherFirst, otherBlocks)) { overlap = true; break; }
+      }
+      if (overlap) {
+        ++gUfsWriteAuthority.deniedWrites;
+        gUfsWriteAuthority.denialReason = 4;
+      } else {
+        if (role == UfsWriteRole::Data) {
+          gUfsWriteAuthority.dataFirst = first;
+          gUfsWriteAuthority.dataBlocks = blocks;
+        } else if (role == UfsWriteRole::Export) {
+          gUfsWriteAuthority.exportFirst = first;
+          gUfsWriteAuthority.exportBlocks = blocks;
+        } else {
+          gUfsWriteAuthority.logFirst = first;
+          gUfsWriteAuthority.logBlocks = blocks;
+        }
+        ok = ufsWriteAuthorityBaseValid (gUfsWriteAuthority);
+      }
+    }
+  }
+  return ok;
+}
+
+static bool ufsWriteAuthorityRegister (UfsWriteRole role, uint64_t first, uint64_t blocks)
+{
+  ufsWriteAuthorityAcquire ();
+  const bool ok = ufsWriteAuthorityRegisterLocked (role, first, blocks);
+  ufsWriteAuthorityRelease ();
+  return ok;
+}
+
+// Register two role windows as one atomic step. The caller must not hold the lock. If either
+// registration fails, the whole object is restored so a partial registration is never published.
+// This removes the unguarded read-modify-write rollback that a caller would otherwise have to do.
+static bool ufsWriteAuthorityRegisterPair (UfsWriteRole roleA, uint64_t firstA, uint64_t blocksA,
+                                           UfsWriteRole roleB, uint64_t firstB, uint64_t blocksB)
+{
+  ufsWriteAuthorityAcquire ();
+  const UfsWriteAuthority before = gUfsWriteAuthority;
+  bool ok = ufsWriteAuthorityRegisterLocked (roleA, firstA, blocksA) &&
+            ufsWriteAuthorityRegisterLocked (roleB, firstB, blocksB);
+  if (!ok) gUfsWriteAuthority = before;
+  ufsWriteAuthorityRelease ();
+  return ok;
+}
+
+// Locked core: the caller holds the authority lock. Requires Ready and a non-empty role window.
+static bool ufsWriteAuthorityRoleWindowLocked (UfsWriteRole role, uint64_t *first, uint64_t *blocks)
+{
+  if (!ufsWriteAuthorityBaseValid (gUfsWriteAuthority) || !ufsWriteWindow (gUfsWriteAuthority, role, first, blocks) ||
+      !*blocks) {
+    ++gUfsWriteAuthority.deniedWrites;
+    gUfsWriteAuthority.denialReason = 5;
+    return false;
+  }
+  return true;
+}
+
+static bool ufsWriteAuthorityRoleWindow (UfsWriteRole role, uint64_t *first, uint64_t *blocks)
+{
+  ufsWriteAuthorityAcquire ();
+  const bool ok = ufsWriteAuthorityRoleWindowLocked (role, first, blocks);
+  ufsWriteAuthorityRelease ();
+  return ok;
+}
+
+// Locked core: the caller holds the authority lock. This is the "may this WRITE be submitted?"
+// decision and it is taken under the same lock that protects a withdrawal.
+static bool ufsWriteAuthorityAllowsLocked (UfsWriteRole role, uint8_t lun, uint64_t lba, uint32_t blocks)
+{
+  if (!ufsWriteAuthorityBaseValid (gUfsWriteAuthority) || lun != 0 || !blocks) {
+    ++gUfsWriteAuthority.deniedWrites;
+    gUfsWriteAuthority.denialReason = 6;
+    return false;
+  }
+  uint64_t first, granted;
+  if (!ufsWriteAuthorityRoleWindowLocked (role, &first, &granted)) return false;
+  if (lba < first || blocks > granted || lba - first >= granted || blocks > granted - (lba - first)) {
+    ++gUfsWriteAuthority.deniedWrites;
+    gUfsWriteAuthority.denialReason = 7;
+    return false;
+  }
+  ++gUfsWriteAuthority.allowedWrites;
+  return true;
+}
+
+static bool ufsWriteAuthorityAllows (UfsWriteRole role, uint8_t lun, uint64_t lba, uint32_t blocks)
+{
+  ufsWriteAuthorityAcquire ();
+  const bool ok = ufsWriteAuthorityAllowsLocked (role, lun, lba, blocks);
+  ufsWriteAuthorityRelease ();
+  return ok;
+}
+
+// Register a submission whose doorbell is about to ring. Caller holds the lock. Called after
+// ufsWriteAuthorityAllowsLocked succeeded and before hostIssue.
+static void ufsWriteAuthorityEnterInflightLocked (void)
+{
+  ++gUfsWriteAuthority.inflight;
+}
+
+// Undo an in-flight registration whose command was never submitted (hostIssue failed before the
+// doorbell). Caller holds the lock.
+static void ufsWriteAuthorityExitInflightLocked (void)
+{
+  if (!gUfsWriteAuthority.inflight) return;
+  --gUfsWriteAuthority.inflight;
+  if (!gUfsWriteAuthority.inflight && gUfsWriteAuthority.state == UfsWriteState::Revoking) {
+    gUfsWriteAuthority.state = gUfsWriteAuthority.revokeFailure ? UfsWriteState::Failed : UfsWriteState::Revoked;
+  }
+}
+
+// Observe the completion of a submitted command. Takes the lock.
+static void ufsWriteAuthorityExitInflight (void)
+{
+  ufsWriteAuthorityAcquire ();
+  ufsWriteAuthorityExitInflightLocked ();
+  ufsWriteAuthorityRelease ();
+}
+
+static uint64_t ufsWriteAuthorityInflight (void)
+{
+  ufsWriteAuthorityAcquire ();
+  const uint64_t inflight = gUfsWriteAuthority.inflight;
+  ufsWriteAuthorityRelease ();
+  return inflight;
+}
+
+// A consistent copy for callers that must compare a live GPT against the authority baseline without
+// holding the lock across I/O.
+static UfsWriteAuthority ufsWriteAuthoritySnapshot (void)
+{
+  ufsWriteAuthorityAcquire ();
+  const UfsWriteAuthority copy = gUfsWriteAuthority;
+  ufsWriteAuthorityRelease ();
+  return copy;
+}
+
+static uint32_t ufsWriteAuthorityEpoch (void)
+{
+  return __atomic_load_n (&gUfsWriteAuthority.epoch, __ATOMIC_ACQUIRE);
+}
+
+// Single-field acquire read of the state. Used by the narrow native handoff that only needs to
+// observe "is the authority still Ready?"; it deliberately does not take the lock so it is safe to
+// call from contexts that must not block. A caller that needs a self-consistent multi-field view
+// must use ufsWriteAuthoritySnapshot.
+static UfsWriteState ufsWriteAuthorityState (void)
+{
+  return static_cast<UfsWriteState> (
+    __atomic_load_n (reinterpret_cast<const uint32_t *> (&gUfsWriteAuthority.state), __ATOMIC_ACQUIRE));
+}
+
+// Record a refusal that happens outside the state-machine helpers (role not permitted at all).
+static void ufsWriteAuthorityNoteDenied (uint32_t reason)
+{
+  ufsWriteAuthorityAcquire ();
+  ++gUfsWriteAuthority.deniedWrites;
+  gUfsWriteAuthority.denialReason = reason;
+  ufsWriteAuthorityRelease ();
+}
diff --git a/tests/RootCommandsConcurrency.cpp b/tests/RootCommandsConcurrency.cpp
new file mode 100644
--- /dev/null
+++ b/tests/RootCommandsConcurrency.cpp
@@ -0,0 +1,373 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+// Deterministic concurrency checks of the production UFS write authority and the WRITE submit
+// window. Real threads; interleavings are forced at the production linearization points through the
+// authority probe, never by random stress. Every WRITE doorbell, its role/window, the revocation and
+// the in-flight count are recorded.
+#include "RootCommandsBridge.cpp"
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <condition_variable>
+#include <mutex>
+#include <thread>
+#include <vector>
+#include <algorithm>
+
+// ---- Fixture ----------------------------------------------------------------------------------------------------
+static constexpr uint64_t kPhys = 0x8cb5e9000ULL;
+static std::mutex gIoMutex;
+static std::mutex gSlotMutex;
+static std::array<uint32_t, 64> gRegisters;
+static std::array<uint8_t, kDmaBytes> gDevice;
+static std::atomic<uint64_t> gNow{ 0 };
+static std::atomic<uint64_t> gSeq{ 0 };
+static std::atomic<uint64_t> gDoorbells{ 0 };
+static std::atomic<uint64_t> gWriteDoorbells{ 0 };
+static std::atomic<uint64_t> gSyncDoorbells{ 0 };
+static std::atomic<uint64_t> gDoorbellSeq{ 0 };
+static std::atomic<uint64_t> gRevokeSeq{ 0 };
+static std::atomic<uint64_t> gCompleteSeq{ 0 };
+static std::atomic<uint64_t> gBadWindow{ 0 };      // WRITE doorbell whose LBA left every expected window
+static std::atomic<bool> gAsync{ false };           // true: the doorbell does not complete the command
+static std::array<int, kRegionSlots> gReleased;     // per slot: a clean happened since the last doorbell
+static std::vector<int> gUsedSlots;
+
+static uint64_t nextSeq () { return gSeq.fetch_add (1, std::memory_order_acq_rel) + 1; }
+
+// The slot a DMA buffer address belongs to, from its offset in the DMA region.
+static int slotForOffset (uint64_t off)
+{
+  for (unsigned s = 0; s < kRegionSlots; ++s) {
+    if (off >= ufsSlotUtrdOffset (s) && off < ufsSlotUtrdOffset (s) + 32) return int (s);
+    if (off >= ufsSlotUcdOffset (s) && off < ufsSlotUcdOffset (s) + kUcdStride) return int (s);
+    if (off >= ufsSlotDataOffset (s) && off < ufsSlotDataOffset (s) + kDataMax) return int (s);
+  }
+  return -1;
+}
+
+static void completeSlotLocked (int slot)
+{
+  uint8_t *utrd = gDevice.data () + ufsSlotUtrdOffset (slot);
+  uint8_t *cmd = gDevice.data () + ufsSlotUcdOffset (slot);
+  uint8_t *rsp = cmd + kRspOffset;
+  *reinterpret_cast<uint32_t *> (utrd + 8) = 0;            // OCS success
+  std::fill (rsp, rsp + 512, 0);
+  memcpy (rsp, cmd, 32);
+  rsp[0] = static_cast<uint8_t> (cmd[0] + 0x20);
+  rsp[1] = 0;
+  if (cmd[0] == 1) putBe32 (rsp + 12, 0);
+  gCompleteSeq.store (nextSeq (), std::memory_order_relaxed);
+}
+
+static uint64_t io (unsigned op, uint64_t address, uint64_t value, void *bytes)
+{
+  if (op == 0) { std::lock_guard<std::mutex> lock (gIoMutex); return gRegisters.at (address / 4); }
+  if (op == 1) {
+    if (address == 0x20) { gRegisters[0x20 / 4] &= ~uint32_t (value); return 0; }
+    if (address == 0x58) {
+      std::lock_guard<std::mutex> lock (gIoMutex);
+      assert (value && !(value & (value - 1)));
+      const unsigned entry = unsigned (__builtin_ctz (uint32_t (value)));
+      assert (entry % 2 == 0 && entry / 2 < kRegionSlots);
+      const int slot = int (entry / 2);
+      assert (gReleased[slot] > 0); gReleased[slot]--;
+      gUsedSlots.push_back (slot);
+      gDoorbells.fetch_add (1, std::memory_order_relaxed);
+      gDoorbellSeq.store (nextSeq (), std::memory_order_relaxed);
+      const uint8_t *cmd = gDevice.data () + ufsSlotUcdOffset (slot);
+      if (cmd[0] == 1 && cmd[16] == 0x2a) {
+        const uint64_t lba = uint64_t (cmd[18]) << 24 | uint64_t (cmd[19]) << 16 | uint64_t (cmd[20]) << 8 | cmd[21];
+        const uint32_t blocks = uint32_t (cmd[23]) << 8 | cmd[24];
+        gWriteDoorbells.fetch_add (1, std::memory_order_relaxed);
+        const bool inData = lba >= 210 && lba + blocks <= 230;
+        const bool inLog = lba >= 400 && lba + blocks <= 416;
+        if (!inData && !inLog) gBadWindow.fetch_add (1, std::memory_order_relaxed);
+      } else if (cmd[0] == 1 && cmd[16] == 0x35) {
+        gSyncDoorbells.fetch_add (1, std::memory_order_relaxed);
+      }
+      gRegisters[0x58 / 4] = 0;
+      if (!gAsync.load ()) completeSlotLocked (slot);
+      return 0;
+    }
+    gRegisters.at (address / 4) = uint32_t (value);
+    return 0;
+  }
+  if (op == 2 || op == 3) {
+    std::lock_guard<std::mutex> lock (gIoMutex);
+    auto at = gDevice.data () + (address - kPhys);
+    if (op == 2) {
+      memcpy (at, bytes, value);
+      const int slot = slotForOffset (address - kPhys);
+      if (slot >= 0) gReleased[slot]++;
+    } else {
+      memcpy (bytes, at, value);
+    }
+    return 0;
+  }
+  if (op == 4) return gNow.load ();
+  if (op == 5) return 0;      // delays never advance the clock: a test forces expiry itself
+  return 0;
+}
+
+// ---- Authority lock (real mutex) and the deterministic probe gate ------------------------------------------------
+static std::mutex gAuthorityMutex;
+static bool authorityTry (void *) { return gAuthorityMutex.try_lock (); }
+static void authorityLock (void *) { gAuthorityMutex.lock (); }
+static void authorityUnlock (void *) { gAuthorityMutex.unlock (); }
+
+static std::mutex gGateMutex;
+static std::condition_variable gGateCond;
+static int gGatePoint = -1;
+static bool gGateHolding = false, gGateOpen = false;
+
+static void probe (int point)
+{
+  std::unique_lock<std::mutex> lock (gGateMutex);
+  if (gGatePoint == point) {
+    gGateHolding = true;
+    gGateCond.notify_all ();
+    gGateCond.wait (lock, [] { return gGateOpen; });
+    gGatePoint = -1;
+  }
+}
+static void armGate (int point)
+{
+  std::unique_lock<std::mutex> lock (gGateMutex);
+  gGatePoint = point; gGateHolding = false; gGateOpen = false;
+}
+static void awaitGateHolding ()
+{
+  std::unique_lock<std::mutex> lock (gGateMutex);
+  gGateCond.wait (lock, [] { return gGateHolding; });
+}
+static void openGate ()
+{
+  std::unique_lock<std::mutex> lock (gGateMutex);
+  gGateOpen = true;
+  gGateCond.notify_all ();
+}
+
+// ---- Common setup ----------------------------------------------------------------------------------------------
+static void resetFixture ()
+{
+  {
+    std::lock_guard<std::mutex> lock (gIoMutex);
+    gRegisters.fill (0); gDevice.fill (0);
+    gRegisters[0x34 / 4] = 1; gRegisters[0x30 / 4] = 15; gRegisters[0x60 / 4] = 1;
+    gReleased.fill (0);
+    gUsedSlots.clear ();
+  }
+  gNow.store (0); gDoorbells.store (0); gWriteDoorbells.store (0); gSyncDoorbells.store (0);
+  gDoorbellSeq.store (0); gRevokeSeq.store (0); gCompleteSeq.store (0); gBadWindow.store (0);
+  gAsync.store (false);
+  ufs_test_reset (io, kPhys);
+  hostSlotsInit (kRegionSlots, reinterpret_cast<IOLock *> (&gSlotMutex));
+}
+
+static bool ready () { return ufs_test_establish (1024, 100, 900, 200, 1023, 1022) != 0; }
+static void revokeAuthority (bool failed) { hostWriteWindowsRevoke (failed); gRevokeSeq.store (nextSeq (), std::memory_order_relaxed); }
+static UfsWriteState state () { return ufsWriteAuthoritySnapshot ().state; }
+static uint64_t inflight () { return ufsWriteAuthorityInflight (); }
+static void completeAllSlots ()
+{
+  std::lock_guard<std::mutex> lock (gIoMutex);
+  for (int s = 0; s < int (kRegionSlots); ++s) completeSlotLocked (s);
+}
+static void pass (const char *name) { std::printf ("PASS: %s\n", name); }
+
+int main ()
+{
+  UfsAuthorityLockOps ops = { &authorityTry, &authorityLock, &authorityUnlock, nullptr };
+  ufsWriteAuthoritySetLock (&ops);
+  ufsWriteAuthoritySetProbe (&probe);
+
+  std::array<uint8_t, 4096> block; std::fill (block.begin (), block.end (), 0x5a);
+
+  // 1. Deny by default, and no doorbell while Sealed.
+  resetFixture ();
+  assert (state () == UfsWriteState::Sealed);
+  assert (ufs_test_write (uint32_t (UfsWriteRole::Data), 0, 210, 1, block.data ()) == kIOReturnNotPrivileged);
+  assert (gDoorbells.load () == 0 && gWriteDoorbells.load () == 0);
+  pass ("Sealed authority denies the WRITE and rings no doorbell");
+
+  // 2. Revoke before the check: the next WRITE is denied with no doorbell.
+  resetFixture (); assert (ready () && ufs_test_store_open (210, 20) == 1);
+  assert (ufs_test_write (uint32_t (UfsWriteRole::Data), 0, 210, 1, block.data ()) == 0);
+  revokeAuthority (false);
+  assert (state () == UfsWriteState::Revoked);
+  const uint64_t beforeDoorbells = gWriteDoorbells.load ();
+  assert (ufs_test_write (uint32_t (UfsWriteRole::Data), 0, 210, 1, block.data ()) == kIOReturnNotPrivileged);
+  assert (gWriteDoorbells.load () == beforeDoorbells);
+  pass ("withdrawn authority denies the next WRITE and rings no doorbell");
+
+  // 3. Revoke after the check, before the doorbell: the withdrawal cannot overtake an in-progress
+  //    submit, and after it linearizes no new doorbell is rung.
+  resetFixture (); assert (ready () && ufs_test_store_open (210, 20) == 1);
+  armGate (UfsProbeAfterCheck);
+  std::thread writer ([&] { assert (ufs_test_write (uint32_t (UfsWriteRole::Data), 0, 210, 1, block.data ()) == 0); });
+  awaitGateHolding ();                              // the writer passed the check and holds the lock
+  std::atomic<bool> revokerDone{ false };
+  std::thread revoker ([&] { revokeAuthority (false); revokerDone.store (true, std::memory_order_release); });
+  std::this_thread::sleep_for (std::chrono::milliseconds (30));   // the revoker must now be blocked on the lock
+  assert (!revokerDone.load (std::memory_order_acquire));          // not linearized: blocked on the authority lock
+  assert (gWriteDoorbells.load () == 0);            // the gate precedes hostIssue: no doorbell has rung yet
+  openGate ();
+  writer.join (); revoker.join ();
+  assert (revokerDone.load ());
+  assert (gDoorbellSeq.load () < gRevokeSeq.load ());             // the doorbell linearized before the withdrawal
+  assert (gWriteDoorbells.load () == 1);
+  assert (state () == UfsWriteState::Revoked);
+  assert (ufs_test_write (uint32_t (UfsWriteRole::Data), 0, 210, 1, block.data ()) == kIOReturnNotPrivileged);
+  assert (gWriteDoorbells.load () == 1);
+  pass ("check -> doorbell is atomic with the withdrawal; no doorbell after revoke");
+
+  // 4. Revoke while a submitted WRITE is still in flight: Revoking until the completion is observed.
+  resetFixture (); assert (ready () && ufs_test_store_open (210, 20) == 1);
+  gAsync.store (true);
+  armGate (UfsProbeAfterRelease);
+  std::thread inflightWriter ([&] { assert (ufs_test_write (uint32_t (UfsWriteRole::Data), 0, 210, 1, block.data ()) == 0); });
+  awaitGateHolding ();                              // doorbell rung, lock released, no completion yet
+  assert (inflight () == 1);
+  revokeAuthority (false);
+  assert (state () == UfsWriteState::Revoking);
+  assert (inflight () == 1);
+  assert (ufs_test_write (uint32_t (UfsWriteRole::Data), 0, 210, 1, block.data ()) == kIOReturnNotPrivileged);
+  assert (gWriteDoorbells.load () == 1);
+  openGate ();                                      // let the writer observe completion
+  completeAllSlots ();
+  inflightWriter.join ();
+  assert (inflight () == 0);
+  assert (state () == UfsWriteState::Revoked);
+  pass ("in-flight WRITE keeps the authority Revoking; the completion finishes the withdrawal");
+
+  // 5. Several in-flight WRITEs: the withdrawal completes only after the last one.
+  resetFixture (); assert (ready () && ufs_test_store_open (210, 20) == 1);
+  gAsync.store (true);
+  const uint64_t targetLbas[3] = { 210, 220, 228 };
+  std::vector<std::thread> writers;
+  for (int i = 0; i < 3; ++i)
+    writers.emplace_back ([&, i] { assert (ufs_test_write (uint32_t (UfsWriteRole::Data), 0, targetLbas[i], 1, block.data ()) == 0); });
+  for (int waited = 0; waited < 5000 && inflight () < 3; ++waited) std::this_thread::sleep_for (std::chrono::milliseconds (1));
+  assert (inflight () == 3);
+  revokeAuthority (false);
+  assert (state () == UfsWriteState::Revoking);
+  assert (ufs_test_write (uint32_t (UfsWriteRole::Data), 0, 215, 1, block.data ()) == kIOReturnNotPrivileged);
+  completeAllSlots ();
+  for (auto &t : writers) t.join ();
+  assert (inflight () == 0);
+  assert (state () == UfsWriteState::Revoked);
+  pass ("three in-flight WRITEs hold Revoking until the last completion");
+
+  // 6. Data and Log writers at once: both keep their own windows and share the one authority.
+  resetFixture (); assert (ready () && ufs_test_store_open (210, 20) == 1);
+  assert (ufs_test_log_open (300, 10, 400, 16) == 1);
+  std::thread dataWriter ([&] { for (int i = 0; i < 200; ++i) assert (ufs_test_write (uint32_t (UfsWriteRole::Data), 0, 210 + (i % 20), 1, block.data ()) == 0); });
+  std::thread logWriter ([&] { for (int i = 0; i < 200; ++i) assert (ufs_test_write (uint32_t (UfsWriteRole::Log), 0, 400 + (i % 16), 1, block.data ()) == 0); });
+  dataWriter.join (); logWriter.join ();
+  assert (inflight () == 0 && gBadWindow.load () == 0 && gWriteDoorbells.load () == 400);
+  pass ("Data and Log writers run concurrently inside their own windows with no overlap");
+
+  // 7. Sync and Data writers at once.
+  resetFixture (); assert (ready () && ufs_test_store_open (210, 20) == 1);
+  std::thread syncWriter ([&] { for (int i = 0; i < 100; ++i) assert (ufs_test_sync (uint32_t (UfsWriteRole::Data)) == 0); });
+  std::thread dataWriter2 ([&] { for (int i = 0; i < 100; ++i) assert (ufs_test_write (uint32_t (UfsWriteRole::Data), 0, 210 + (i % 20), 1, block.data ()) == 0); });
+  syncWriter.join (); dataWriter2.join ();
+  assert (inflight () == 0 && gSyncDoorbells.load () == 100 && gWriteDoorbells.load () == 100);
+  pass ("SYNCHRONIZE CACHE and WRITE share the authority and both complete");
+
+  // 8. Timeout: a submitted WRITE that never completes is failed closed and latches Failed.
+  resetFixture (); assert (ready () && ufs_test_store_open (210, 20) == 1);
+  gAsync.store (true);
+  armGate (UfsProbeAfterRelease);
+  std::thread timeoutWriter ([&] { ufs_test_write (uint32_t (UfsWriteRole::Data), 0, 210, 1, block.data ()); });
+  awaitGateHolding ();
+  assert (inflight () == 1);
+  gNow.store (1ULL << 62);                          // force the wait to expire (deadline was computed earlier)
+  openGate ();
+  timeoutWriter.join ();
+  assert (state () == UfsWriteState::Failed);
+  assert (inflight () == 0);
+  // The latched authority denies at its own gate...
+  assert (!ufsWriteAuthorityAllows (UfsWriteRole::Data, 0, 210, 1));
+  const uint64_t afterTimeout = gWriteDoorbells.load ();
+  // ...and the timed-out transport also poisons the controller, so a follow-up is refused at the
+  // readiness guard before the authority check. Either way it is denied and rings no doorbell.
+  assert (ufs_test_write (uint32_t (UfsWriteRole::Data), 0, 210, 1, block.data ()) != kIOReturnSuccess);
+  assert (gWriteDoorbells.load () == afterTimeout);
+  completeAllSlots ();                              // the un-cancellable DMA arrives late
+  assert (gWriteDoorbells.load () == afterTimeout); // a late completion is not a new submission
+  pass ("a timed-out WRITE fails closed and revokes; a late completion is not a new submission");
+
+  // 9. Epoch monotonicity and re-authorization after a clean Reset + Establish.
+  resetFixture (); assert (ready () && ufs_test_store_open (210, 20) == 1);
+  const uint32_t epochReady = ufsWriteAuthoritySnapshot ().epoch;
+  revokeAuthority (false);
+  const uint32_t epochRevoked = ufsWriteAuthoritySnapshot ().epoch;
+  assert (epochRevoked > epochReady);
+  ufsWriteAuthorityReset ();
+  assert (state () == UfsWriteState::Sealed);
+  assert (ready ());
+  const uint32_t epochReestablished = ufsWriteAuthoritySnapshot ().epoch;
+  assert (epochReestablished > epochRevoked);
+  assert (ufs_test_store_open (210, 20) == 1);
+  assert (ufs_test_write (uint32_t (UfsWriteRole::Data), 0, 210, 1, block.data ()) == 0);
+  assert (inflight () == 0);
+  pass ("epoch increases across revoke and re-establish; the re-authorized window writes again");
+
+  // 10. Establish is refused while I/O is still in flight (no reuse of a region under a pending DMA).
+  resetFixture (); assert (ready () && ufs_test_store_open (210, 20) == 1);
+  gAsync.store (true);
+  armGate (UfsProbeAfterRelease);
+  std::thread pendingWriter ([&] { assert (ufs_test_write (uint32_t (UfsWriteRole::Data), 0, 210, 1, block.data ()) == 0); });
+  awaitGateHolding ();
+  assert (inflight () == 1);
+  revokeAuthority (false);
+  assert (state () == UfsWriteState::Revoking);
+  ufsWriteAuthorityReset ();                         // a re-verification attempts to republish
+  assert (state () == UfsWriteState::Sealed);
+  assert (inflight () == 1);
+  assert (!ufsWriteAuthorityEstablish (1024, 100, 900, 200, 1023, 1022,
+                                      0x11112222, 0x22223333, 0xaaaabbbb, 0x22223333, 0,
+                                      kUfsDarwinTypeGuid, kUfsDarwinTypeGuid, kUfsDarwinTypeGuid));
+  pass ("Establish is refused while an I/O is still in flight");
+  openGate ();
+  completeAllSlots ();
+  pendingWriter.join ();
+  assert (inflight () == 0);
+
+  // 11. A paired Export+Log open publishes both windows as one atomic step and rolls the whole
+  //     object back when either window is invalid; a rejected open must not leak the accepted half.
+  resetFixture (); assert (ready () && ufs_test_store_open (210, 20) == 1);
+  assert (ufs_test_log_open (300, 10, 305, 10) == 0);                 // Log overlaps Export -> refused as a unit
+  assert (!ufsWriteAuthorityAllows (UfsWriteRole::Export, 0, 300, 1)); // the accepted half was rolled back
+  assert (!ufsWriteAuthorityAllows (UfsWriteRole::Log, 0, 305, 1));
+  assert (ufs_test_log_open (300, 10, 400, 16) == 1);                 // a disjoint pair still opens
+  assert (ufsWriteAuthorityAllows (UfsWriteRole::Export, 0, 300, 1));
+  assert (ufsWriteAuthorityAllows (UfsWriteRole::Log, 0, 400, 1));
+  assert (gWriteDoorbells.load () == 0 && inflight () == 0);
+  pass ("a failed Export+Log open rolls back as one unit and leaks no half-registered window");
+
+  // 12. Concurrent (re)initialization and withdrawal. Openers publish windows and write inside them
+  //     while a revoker withdraws in a loop. Every WRITE that reaches a doorbell must stay inside the
+  //     published Data window, and the object must always parse as a valid state with no I/O left.
+  resetFixture (); assert (ready ());
+  std::atomic<bool> stop{ false };
+  std::thread opener ([&] {
+    for (int i = 0; i < 4000 && !stop.load (); ++i) {
+      ufsWriteAuthorityReset ();
+      ufs_test_establish (1024, 100, 900, 200, 1023, 1022);
+      if (ufs_test_store_open (210, 20)) ufs_test_write (uint32_t (UfsWriteRole::Data), 0, 210 + (i % 20), 1, block.data ());
+      hostWriteWindowsRevoke (false);
+    }
+  });
+  std::thread revoker2 ([&] { for (int i = 0; i < 4000 && !stop.load (); ++i) revokeAuthority ((i & 1) != 0); });
+  opener.join (); revoker2.join (); stop.store (true);
+  assert (inflight () == 0);
+  // Deny-by-default holds at rest: a WRITE is only ever allowed while the state is exactly Ready.
+  if (state () != UfsWriteState::Ready) assert (!ufsWriteAuthorityAllows (UfsWriteRole::Data, 0, 210, 1));
+  pass ("concurrent initialization and withdrawal never submits an out-of-window WRITE and leaves no I/O in flight");
+
+  assert (gBadWindow.load () == 0);
+  std::puts ("PASS: unified UFS write authority -- check/doorbell linearization, single shared state, revoke before/after submit, in-flight gating, timeout fail-closed, epoch and re-authorization");
+  return 0;
+}
