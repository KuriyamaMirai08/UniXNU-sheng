+def resume_digest(spec, field):
+    value = spec.get('resume_only_storage_' + field + '_sha256')
+    if not isinstance(value, str) or not re.fullmatch(r'[a-f0-9]{64}', value) or value == '0' * 64:
+        raise Error(f'resume-only storage requires a fixed {field} SHA-256')
+    return value
+
+
+def resume_only_recovery(spec, kernel, arguments):
+    """Admit an exact WAL v2 kernel to a menu with no initialization entry."""
+    expected = spec.get('resume_only_storage_kernel_sha256')
+    if expected is None:
+        if any(key.startswith('resume_only_storage_') for key in spec):
+            raise Error('incomplete resume-only storage policy')
+        return None
+    expected = resume_digest(spec, 'kernel')
+    sealed = resume_digest(spec, 'sealed_kernel')
+    if expected == sealed:
+        raise Error('resume-only storage must distinguish the strict and sealed kernel identities')
+    if (spec.get('install') is not None or spec.get('panic_screen') or spec.get('entry_probe_reset_delay')
+            or spec.get('prepatch_fileset_static_if')):
+        raise Error('resume-only storage forbids Install and post-admission kernel mutation')
+    adt = spec.get('adt', {})
+    if adt.get('owned_memory_excluded_ranges') or adt.get('owned_memory_outside_ranges'):
+        raise Error('resume-only storage requires the contiguous W^X loader profile')
+    if sha256_file(kernel) not in {expected, sealed}:
+        raise Error('resume-only storage kernel identity mismatch')
+    values = {}
+    for argument in arguments:
+        key, separator, value = argument.lstrip('-').partition('=')
+        if key in {'validation_disables', 'serverperfmode', 'lcks'}:
+            raise Error(f'resume-only storage seal does not model {key}')
+        if key in {'data-reset', 'data-wal-v2', 'data-persist', 'log'}:
+            if not separator or argument.startswith('-') or key == 'data-reset' or key in values:
+                raise Error(f'resume-only storage forbids invalid or repeated {key}')
+            values[key] = value
+    if values.get('data-persist') != '2' or values.get('data-wal-v2') != '1':
+        raise Error('resume-only storage Boot requires data-persist=2 and data-wal-v2=1')
+    recovery = [argument for argument in arguments
+                if argument.lstrip('-').split('=', 1)[0] not in {'data-persist', 'log'}]
+    return check_args([*recovery, 'data-persist=1', 'log=0'])
+
+
+def stage_resume_kernel(ctx, spec, source, staged, arguments):
+    raw, sealed = (resume_digest(spec, name) for name in ('kernel', 'sealed_kernel'))
+    shutil.copyfile(source, staged)
+    staged_digest = sha256_file(staged)
+    if staged_digest == raw:
+        sealer = ctx.tree / 'scripts/seal-source-crypto-kernel.py'
+        for field, tool_path in (('sealer', sealer), ('kernel_target', ctx.tree / 'scripts/kernel_target.py'),
+                                 ('kc_image', ctx.tree / 'kits/XnuPrelink/kc_image.py')):
+            if not tool_path.is_file() or sha256_file(tool_path) != resume_digest(spec, field):
+                raise Error(f'resume-only storage {field} identity mismatch')
+        run([sys.executable, sealer, staged, '--prepatch-fileset-static-if', '--kernel-args=' + arguments], cwd=ctx.tree,
+            env=dict(os.environ, UNIXNU_XNU_ARCH='arm64e'), log_file=ctx.logs / 'payload-seal.log')
+        staged.with_suffix(staged.suffix + '.crypto-hmac.json').unlink(missing_ok=True)
+        staged_digest = sha256_file(staged)
+    if staged_digest != sealed:
+        raise Error('resume-only staged kernel does not match the accepted seal')
+
+
+def check_resume_seed(spec, data, skip_setup):
+    if skip_setup or data is None or not spec.get('adt', {}).get('packed_data_ramdisk'):
+        raise Error('resume-only storage requires the unchanged packed Data seed')
+    wanted = resume_digest(spec, 'seed')
+    logical_bytes = spec.get('resume_only_storage_seed_bytes')
+    if type(logical_bytes) is not int:
+        raise Error('resume-only storage requires fixed packed seed identity and logical size')
+    with data.open('rb') as stream:
+        physical_bytes = os.fstat(stream.fileno()).st_size
+        if not 32 <= physical_bytes <= 256 << 20:
+            raise Error('packed Data seed exceeds DarwinBoot input bounds')
+        header = stream.read(32)
+        if (len(header) != 32 or header[:8] != b'DBRDISK1' or int.from_bytes(header[8:12], 'little') != 1
+                or int.from_bytes(header[12:16], 'little') != 4096 or not 0 < logical_bytes <= 1 << 40
+                or logical_bytes % 4096 or int.from_bytes(header[16:24], 'little') != logical_bytes):
+            raise Error('resume-only packed Data seed geometry mismatch')
+        count = int.from_bytes(header[24:32], 'little')
+        if not 0 < count <= min(65536, (physical_bytes - 32) // 16):
+            raise Error('resume-only packed Data seed requires a bounded extent table')
+        cursor = 32 + 16 * count
+        end = 0
+        extents = stream.read(count * 16)
+        if len(extents) != count * 16:
+            raise Error('truncated packed Data seed extent table')
+        for offset, length in struct.iter_unpack('<QQ', extents):
+            if (not length or (offset | length) % 4096 or offset < end or offset + length > logical_bytes
+                    or cursor + length > physical_bytes):
+                raise Error('resume-only packed Data seed extent lies outside its layout')
+            end, cursor = offset + length, cursor + length
+        stream.seek(0)
+        if cursor != physical_bytes or hashlib.file_digest(stream, 'sha256').hexdigest() != wanted:
+            raise Error('resume-only packed Data seed byte identity or extent length mismatch')
+
