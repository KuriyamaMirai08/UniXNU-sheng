+		uc = '?';
+	}
+	uint64_t glyph = sheng_diag_font[uc - 32];
+	for (int row = 0; row < 10; row++) {
+		uint8_t bits = (uint8_t)((glyph >> row_shifts[row]) & 0x1FU);
+		for (int col = 0; col < 5; col++) {
+			if (bits & (1u << col)) {
+				for (int sy = 0; sy < 3; sy++) {
+					for (int sx = 0; sx < 3; sx++) {
+						int px = x + col * 3 + sx;
+						int py = y + row * 3 + sy;
+						if (px >= 0 && px < 3048 && py >= 0 && py < 2032) {
+							fb[(size_t)py * stride_px + (size_t)px] = fg;
+						}
+					}
+				}
+			}
+		}
+	}
+}
+
+static void
+sheng_diag_draw_hex64(volatile uint32_t *fb, uint32_t stride_px, int *cx, int *cy, uint64_t val)
+{
+	static const char hex[] = "0123456789ABCDEF";
+	char buf[19];
+	buf[0] = '0';
+	buf[1] = 'x';
+	for (int i = 0; i < 16; i++) {
+		buf[2 + i] = hex[(val >> ((15 - i) * 4)) & 0xFU];
+	}
+	buf[18] = '\0';
+	for (int i = 0; buf[i] != '\0'; i++) {
+		if (*cx + 18 >= 3000) {
+			*cx = 40;
+			*cy += 42;
+		}
+		if (*cy + 36 >= 1980) {
+			return;
+		}
+		sheng_diag_draw_char(fb, stride_px, *cx, *cy, buf[i], 0xFFFFFFFFU);
+		*cx += 18;
+	}
+}
+
+static void
+sheng_diag_draw_str(volatile uint32_t *fb, uint32_t stride_px, int *cx, int *cy, const char *s)
+{
+	for (int i = 0; s[i] != '\0'; i++) {
+		if (*cx + 18 >= 3000) {
+			*cx = 40;
+			*cy += 42;
+		}
+		if (*cy + 36 >= 1880) {
+			return;
+		}
+		sheng_diag_draw_char(fb, stride_px, *cx, *cy, s[i], 0xFFFFFFFFU);
+		*cx += 18;
+	}
+}
+
+static void
+sheng_diag_draw_kv(volatile uint32_t *fb, uint32_t stride_px, int *cx, int *cy, const char *label, uint64_t val)
+{
+	sheng_diag_draw_str(fb, stride_px, cx, cy, label);
+	sheng_diag_draw_hex64(fb, stride_px, cx, cy, val);
+	*cx += 18;
+}
+
