+++ b/NativeUfs.cpp
@@ -1566,6 +1566,46 @@ static void storeAccount (volatile uint64_t *ops, volatile uint64_t *ticks, uint
   while (spent > seen && !__atomic_compare_exchange_n (&native_ufs_store_max_ticks, &seen, spent, false, __ATOMIC_RELAXED, __ATOMIC_RELAXED)) { }
 }
 
+static uint64_t gLedgerRegionFirst = 0, gLedgerRegionBlocks = 0;
+static constexpr uint64_t kLedgerGuardBlocks = 1024;
+static constexpr uint64_t kLedgerBlocks = 16;
+
+extern "C" int native_ufs_ledger_open (uint64_t storeFirst, uint64_t *ledgerFirst, const char **why)
+{
+  const char *reason = "";
+  int ok = 0;
+  if (!gStoreGeometry.valid || !gHost.ready || hostTransportPoisoned ()) reason = "no root layout";
+  else if (gLedgerRegionBlocks) reason = "ledger already open";
+  else {
+    uint64_t imageBlocks = (gStoreGeometry.imageBytes + 4095) / 4096;
+    if (storeFirst < gStoreGeometry.first + imageBlocks + kLedgerGuardBlocks + kLedgerBlocks ||
+        storeFirst > gStoreGeometry.last + 1) {
+      reason = "ledger overlaps root or guard";
+    } else {
+      uint64_t first = storeFirst - kLedgerGuardBlocks - kLedgerBlocks;
+      if (!ufsWriteAuthorityRegister (UfsWriteRole::Ledger, first, kLedgerBlocks)) reason = "ledger authority refused";
+      else {
+        gLedgerRegionFirst = first;
+        gLedgerRegionBlocks = kLedgerBlocks;
+        if (ledgerFirst) *ledgerFirst = first;
+        ok = 1;
+      }
+    }
+  }
+  if (why) *why = reason;
+  return ok;
+}
+
+extern "C" int native_ufs_ledger_read (uint64_t rel, uint32_t blocks, void *dst)
+{
+  uint64_t lba = 0;
+  if (!gLedgerRegionBlocks || !dst || !blocks || rel >= gLedgerRegionBlocks ||
+      blocks > gLedgerRegionBlocks - rel || !checkedWriteLba (gLedgerRegionFirst, rel, blocks, &lba)) {
+    return 0;
+  }
+  return hostRead4k (0, lba, blocks, dst) == kIOReturnSuccess;
+}
+
 extern "C" int native_ufs_store_read (uint64_t rel, uint32_t blocks, void *dst)
 {
   if (!gStoreRegionBlocks || !dst || !blocks || rel >= gStoreRegionBlocks || blocks > gStoreRegionBlocks - rel) return 0;
