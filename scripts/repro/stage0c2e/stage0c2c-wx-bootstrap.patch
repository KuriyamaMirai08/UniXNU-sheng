+#if !defined(APPLE_ARM64_ARCH_FAMILY) && !__ARM_16K_PG__
+/*
+ * Before changing TTBR1, enforce the same physical W^X partition as the
+ * two bootstrap roots. An old TLB entry cannot then grant an opposing
+ * permission while the new root is taking effect.
+ */
+static bool
+arm_vm_wx_transition_leaf(tt_entry_t entry, unsigned int shift,
+    pmap_paddr_t exec_start, pmap_paddr_t exec_end)
+{
+	const pmap_paddr_t size = 1ULL << shift;
+	const pmap_paddr_t first = (entry & ARM_PTE_MASK) & ~(size - 1);
+	const pmap_paddr_t end = first + size;
+	const bool overlaps_exec = first < exec_end && exec_start < end;
+	const bool writable = (entry & ARM_PTE_AP(2)) == 0;
+	const bool el1_exec = (entry & ARM_PTE_PNX) == 0;
+	const tt_entry_t attribute_mask = ARM_PTE_ATTRINDXMASK | ARM_PTE_SHMASK;
+	const tt_entry_t match = ARM_PTE_ATTRINDX(CACHE_ATTRINDX_WRITEBACK) | ARM_PTE_SH(SH_OUTER_MEMORY);
+	/* Do not rely on hierarchical permissions or SCTLR.WXN. */
+	return (!overlaps_exec || ((entry & ARM_PTE_APMASK) == ARM_PTE_AP(AP_RONA) &&
+				(entry & ARM_PTE_NX) && (entry & attribute_mask) == match)) &&
+	       (!el1_exec || (!writable && exec_start <= first && end <= exec_end));
+}
+
+static void
+arm_vm_wx_check_root(const tt_entry_t *table, unsigned int shift,
+    pmap_paddr_t exec_start, pmap_paddr_t exec_end)
+{
+	const unsigned int entries = shift == ARM_TT_L1_SHIFT ?
+	    (1U << (64 - T1SZ_BOOT - ARM_TT_L1_SHIFT)) : TTE_PGENTRIES;
+	for (unsigned int slot = 0; slot < entries; slot++) {
+		const tt_entry_t entry = table[slot];
+		if (!(entry & ARM_TTE_VALID)) {
+			continue;
+		}
+		const bool table_type = (entry & ARM_TTE_TYPE_MASK) == ARM_TTE_TYPE_TABLE;
+		if (shift > ARM_PGSHIFT && table_type) {
+			const pmap_paddr_t child = entry & ARM_TTE_TABLE_MASK;
+			if (child < gPhysBase || child - gPhysBase >= mem_size ||
+			    mem_size - (child - gPhysBase) < ARM_PGBYTES) {
+				panic("TTBR1 table outside bootstrap memory");
+			}
+			arm_vm_wx_check_root((const tt_entry_t *)phystokv(child), shift - 9,
+			    exec_start, exec_end);
+		} else if ((shift == ARM_PGSHIFT && !table_type) ||
+		    !arm_vm_wx_transition_leaf(entry, shift, exec_start, exec_end)) {
+			panic("TTBR1 transition incompatible with bootstrap W^X partition");
+		}
+	}
+}
+
+/* This runs only after arm_vm_wx_check_root validated all child pointers. */
+static bool
+arm_vm_wx_exec_covered(const tt_entry_t *table, vm_offset_t va, pmap_paddr_t expected)
+{
+	for (unsigned int shift = ARM_TT_L1_SHIFT;; shift -= 9) {
+		const unsigned int slot = shift == ARM_TT_L1_SHIFT ?
+		    L1_TABLE_T1_INDEX(va, TCR_EL1_BOOT) : ((va >> shift) & (TTE_PGENTRIES - 1));
+		const tt_entry_t entry = table[slot];
+		if (!(entry & ARM_TTE_VALID)) {
+			return false;
+		}
+		if (shift == ARM_PGSHIFT || (entry & ARM_TTE_TYPE_MASK) != ARM_TTE_TYPE_TABLE) {
+			const pmap_paddr_t mask = (1ULL << shift) - 1;
+			const pmap_paddr_t addr = ((entry & ARM_PTE_MASK) & ~mask) | (va & mask);
+			return addr == expected && (entry & ARM_PTE_PNX) == 0;
+		}
+		if (entry & ARM_TTE_TABLE_PXN) {
+			return false;
+		}
+		table = (const tt_entry_t *)phystokv(entry & ARM_TTE_TABLE_MASK);
+	}
+}
